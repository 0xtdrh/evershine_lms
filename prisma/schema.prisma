// Evershaheen Academy LMS — Prisma Schema
// WHY: Prisma provides compile-time type safety for all DB operations,
//      preventing the fragile raw-SQL pattern previously used in this codebase.
// Target: PostgreSQL 16+ (Neon Serverless)

generator client {
  provider      = "prisma-client-js"
  // Hostinger runs on OpenSSL 1.1 while CI/local builds commonly use OpenSSL 3.
  // Include both engines so the standalone runtime can execute on either host.
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
  GUARDIAN
  SECRETARY
  BRANCH_MANAGER
  MARKETING
}

enum TimetableSlotType {
  SUBJECT
  BREAK
  PRAYER
  LUNCH
  ASSEMBLY
  ACTIVITY
}

enum TeacherSectionAssignmentStatus {
  ACTIVE
  REVOKED
}

enum Gender {
  MALE
  FEMALE
}

enum FeeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum EnrollmentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  WITHDRAWN
  ON_LEAVE
}

enum AdmissionStatus {
  PENDING
  APPROVED
  DECLINED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum CertificateType {
  BONAFIDE
  ACHIEVEMENT
  COMPLETION
  BIRTHDAY
  PERFORMANCE
  ID_CARD
  RESULT_CARD
  STUDENT_PROFILE
  TEACHER_ID_CARD
  TEACHER_EXPERIENCE_LETTER
  TEACHER_PROFILE
}

enum TaskType {
  ASSIGNMENT
  QUIZ
  CP
  MID_TERM
  FINAL_TERM
  OTHER
}

enum ApplicationType {
  LEAVE
  ADVANCE_SALARY
  PROGRESS_UPDATE
  OTHER
}

enum SessionShift {
  MORNING
  EVENING
  NIGHT
}

enum FeedbackCategory {
  TEACHER
  ACADEMIC_STAFF
  MANAGEMENT
  ACCOUNTS
  LMS_SERVICES // Portal usability, digital tools, online resources
  ACADEMY_SERVICES // Facilities, cleanliness, transport, admin office
}

enum FeedbackLikertResponse {
  STRONGLY_AGREE
  AGREE
  NEUTRAL
  DISAGREE
}

enum ClassDeliveryMode {
  PHYSICAL
  ONLINE
  HYBRID
}

enum AcademicEnrollmentStatus {
  ACTIVE
  PROMOTED
  RETAINED
  TRANSFERRED
  GRADUATED
  WITHDRAWN
}

enum SubjectEnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CurriculumMode {
  FIXED
  ELECTIVE
}

enum PenaltyType {
  FIXED
  PERCENTAGE
}

enum PenaltyAssessmentType {
  STUDENT_ABSENCE
  STUDENT_LEAVE
  TEACHER_LATE
  TEACHER_LEAVE
}

enum PenaltyAssessmentStatus {
  PENDING
  APPROVED
  REJECTED
  WAIVED
  POSTED
  REVERSED
}

enum TeacherHrAttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE
}

enum PromotionStatus {
  PROMOTED
  RETAINED
  TRANSFERRED
  GRADUATED
}

// WHY: Categorises institutional expense records for filtered reporting
enum ExpenseCategory {
  UTILITIES // Electricity, gas, water bills
  SALARIES // Non-teaching staff wages
  MAINTENANCE // Building, equipment repairs
  STATIONERY // Office and classroom supplies
  EQUIPMENT // Furniture, hardware, tools
  TRANSPORT // Vehicle fuel, vehicle hire
  EVENTS // Sports gala, prize distribution, ceremonies
  MISCELLANEOUS // Any uncategorised expense
}

// WHY: Tracks lifecycle of visitor inquiries submitted via landing page contact form.
// NEW→SEEN on first admin view; SEEN→REPLIED when admin responds; terminal: RESOLVED or SPAM.
enum InquiryStatus {
  NEW
  SEEN
  REPLIED
  RESOLVED
  SPAM
}

// WHY: Distinguishes the channel through which the inquiry arrived.
// CONTACT_FORM is the only channel today; WHATSAPP reserved for future integration.
enum InquirySource {
  CONTACT_FORM
  WHATSAPP
}

// WHY: Full lifecycle for teacher/staff applications submitted via landing page.
// PENDING→UNDER_REVIEW on first admin open; then approve/decline/interview/hold.
enum StaffApplicationStatus {
  PENDING
  UNDER_REVIEW
  INTERVIEW_SCHEDULED
  APPROVED
  DECLINED
  ON_HOLD
}

// WHY: Differentiates the role the applicant is seeking.
// Determines which Prisma model (Teacher/Accountant/Admin) is provisioned on approval.
enum StaffApplicantType {
  TEACHER
  ACCOUNTANT
  ADMIN_STAFF
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE AUTH ENTITY
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  // WHY passwordHash stored separately: never return this field in API responses
  passwordHash           String
  role                   Role      @default(STUDENT)
  isActive               Boolean   @default(true)
  // Set when a password is issued by someone else (staff reset / temporary
  // password). The user must choose a new password before using the app.
  mustChangePassword     Boolean   @default(false)
  // Sessions that signed in before this moment are rejected (set when the
  // password changes or is reset). See lib/session-guard.ts.
  sessionsRevokedAt      DateTime?
  /// Phase C: birthday for parents and non-teacher staff (students and teachers keep their own dateOfBirth).
  dateOfBirth            DateTime? @db.Date
  lastLogin              DateTime?
  emailVerified          Boolean   @default(false)
  emailVerifiedAt        DateTime?
  displayName            String?
  profilePictureUrl      String?
  profilePicturePublicId String?
  profileStatus          String    @default("ACTIVE")
  profileUpdatedAt       DateTime?
  profileSource          String    @default("SYSTEM")
  // Short-lived reset token; always expires after 1 hour
  resetToken             String?   @unique
  resetTokenExpiry       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Profile relationships — at most one of these is populated per user
  student       Student?
  teacher       Teacher?
  admin         Admin?
  parent        Parent?
  accountant    Accountant?
  guardian      Guardian?
  branchManager BranchManager?
  secretary     Secretary?
  marketingStaff MarketingStaff?

  // Audit trail — every mutation this user performs
  auditLogs                 AuditLog[]
  sessions                  Session[]
  notifications             Notification[]
  enrollmentTypeAuditLogs   EnrollmentTypeAuditLog[]
  createdExamDateSheets     ExamDateSheet[]
  declaredTermResults       TermResult[]
  markedDailyScores         DailyPerformanceScore[]
  assignedTargets           TargetAssignment[]
  retroactiveScoreEdits     RetroactiveScoreEditLog[]
  createdRolePermissions    RolePermission[]
  requestedRoleAssumptions  RoleAssumption[]
  recordedExpenses          Expense[]                 @relation("ExpenseRecordedByUser")
  profileChangeRequests     ProfileChangeRequest[]    @relation("ProfileChangeRequestsUser")
  requestedProfileChanges   ProfileChangeRequest[]    @relation("ProfileChangeRequestsRequester")
  reviewedProfileChanges    ProfileChangeRequest[]    @relation("ProfileChangeRequestsReviewer")
  attendanceImports         AttendanceImportLog[]
  createdTimetableTemplates TimetableTemplate[]       @relation("TimetableTemplateCreatedBy")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model ProfileChangeRequest {
  id             String    @id @default(cuid())
  userId         String
  requestedById  String
  requestedField String
  proposedValue  String?
  currentValue   String?
  reason         String?
  status         String    @default("PENDING")
  reviewedById   String?
  reviewedAt     DateTime?
  reviewerNote   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User  @relation("ProfileChangeRequestsUser", fields: [userId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("ProfileChangeRequestsRequester", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("ProfileChangeRequestsReviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedById])
}

// NextAuth.js v5 session table
model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPUS & BATCH STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Campus {
  // WHY: Boys and Girls campuses are independently managed with separate
  //      teachers, batches, and financial tracking
  id            String   @id @default(cuid())
  name          String   @unique // "Boys Campus", "Girls Campus"
  code          String   @unique // "BC", "GC"
  address       String
  phone         String
  email         String
  principalName String
  isActive      Boolean  @default(true)
  // Branch profile (phase A, 2026-10-03) — all optional
  mapUrl        String?
  whatsapp      String?
  workingHours  String?  @db.Text
  roomsCount    Int?
  maxStudents   Int?
  managerUserId String?
  profileNotes  String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batches                Batch[]
  students               Student[]
  teachers               Teacher[]
  classes                Class[]
  admins                 Admin[]
  rooms                  Room[]
  classSections          ClassSection[]
  feePolicies            FeePolicy[]
  teacherPenaltyPolicies TeacherPenaltyPolicy[]
  accountants            Accountant[]
  expenses               Expense[]
  profitLossStatements   ProfitLossStatement[]
  branchManagers         BranchManager[]
  secretaries            Secretary[]
  marketingStaff         MarketingStaff[]

  waitingListEntries WaitingListEntry[]
  @@index([code])
  @@index([isActive])
}

model Batch {
  // WHY: Batches represent academic tiers — Kids Campus, Junior, Matriculation,
  //      Intermediate — each with different fee structures and curricula
  id                    String   @id @default(cuid())
  name                  String // "Kids Campus", "Junior", "Matriculation", "Intermediate"
  code                  String // "KC", "JR", "MAT", "INT"
  campusId              String
  academicLevel         String // "PreSchool", "Elementary", "Secondary", "HigherSecondary"
  forceGenderSeparation Boolean  @default(false)
  description           String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campus        Campus         @relation(fields: [campusId], references: [id])
  classes       Class[]
  students      Student[]
  teachers      Teacher[]
  houses        House[]
  announcements Announcement[]
  classSections ClassSection[]
  feePolicies   FeePolicy[]

  @@unique([name, campusId])
  @@index([campusId])
  @@index([isActive])
}

model House {
  // WHY: House system (Shaheen, Parvaaz, Junoon, Udraan, Pehchaan) is used
  //      for sports gala competitions and student identity
  id            String   @id @default(cuid())
  name          String // "Shaheen", "Parvaaz", "Junoon", "Udraan", "Pehchaan"
  color         String // Hex color code for UI display
  batchId       String
  motto         String?
  points        Int      @default(0)
  captainId     String?
  viceCaptainId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch       Batch        @relation(fields: [batchId], references: [id])
  captain     Student?     @relation("HouseCaptain", fields: [captainId], references: [id])
  viceCaptain Student?     @relation("HouseViceCaptain", fields: [viceCaptainId], references: [id])
  students    Student[]
  events      SportEvent[]
  teachers    Teacher[]    @relation("HouseTeachers")

  @@unique([name, batchId])
  @@index([batchId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PEOPLE ENTITIES
// ─────────────────────────────────────────────────────────────────────────────

model Student {
  id                 String   @id @default(cuid())
  userId             String   @unique
  registrationNumber String   @unique
  admissionNumber    String?  @unique
  firstName          String
  lastName           String
  fullNameAr         String? // Full four-part Arabic legal name, e.g. "أحمد محمد علي حسن"
  fullNameEn         String? // Full four-part English legal name, printed on certificates
  fatherName         String
  fatherPhoneNumber  String?
  fatherOccupation   String?
  motherName         String?
  motherPhoneNumber  String?
  motherOccupation   String?
  // BOTH_ALIVE | FATHER_DECEASED | MOTHER_DECEASED | BOTH_DECEASED | DIVORCED
  parentStatus       String?  @default("BOTH_ALIVE")
  dateOfBirth        DateTime
  gender             Gender
  bloodGroup         String?
  nationality        String   @default("Egyptian")
  address            String
  city               String

  // Contact
  phoneNumber      String
  emergencyContact String
  email            String?

  // School & prior background
  schoolName                  String? // Current regular school the student attends
  regularSchoolGrade          String? // Grade/year in their regular school, e.g. "الصف الرابع الابتدائي"
  priorProgrammingExperience  String? // Free-text note on any programming/robotics experience before TechNova

  // Optional medical note — never required
  medicalNotes String? // Optional: allergies, conditions staff should be aware of

  // Marketing / Referral
  sourceOfInfo String? // Facebook, Instagram, School, Referral, etc.
  nearestBranchId String? // Campus nearest to the student's home, may differ from enrolled campus

  // Sibling linkage at same academy
  hasSiblingAtAcademy Boolean @default(false)
  siblingName         String? // Full name of sibling enrolled here
  siblingClass        String? // Class/Section of sibling

  // Academic placement
  campusId      String
  batchId       String
  classId       String?
  section       String?
  rollNumber    String?
  houseId       String?
  /// Phase B: the parent chooses if the child sees the wallet in the student portal
  walletVisibleToStudent Boolean @default(true)
  /// Foundations (2026-10-09): staff-only exception — do not use this child in marketing (agreed offline with the parent)
  noMarketing Boolean @default(false)
  admissionDate DateTime          @default(now())
  firstSessionDate DateTime? // Set automatically the first time attendance is recorded for this student
  academicYear  String // "2024-2025"
  // WHY shift: Student is enrolled in Morning, Evening, or Night coaching session
  shift         SessionShift      @default(MORNING)
  deliveryMode  ClassDeliveryMode @default(PHYSICAL)
  rulesAccepted Boolean           @default(false)

  // Fee summary — denormalized for fast dashboard queries
  // TRADEOFF: Slight denormalization here accepted because fee dashboard
  //           reads are far more frequent than writes
  feeStatus      FeeStatus @default(PENDING)
  totalFeeAmount Decimal   @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal   @default(0) @db.Decimal(10, 2)
  dueAmount      Decimal   @default(0) @db.Decimal(10, 2)

  // Documents
  profilePicture    String? // Student photo — Cloudinary URL
  idCardQRCode      String? // QR code data string
  idCardIssueDate   DateTime?
  idCardExpiryDate  DateTime?

  // Status
  enrollmentStatus EnrollmentStatus @default(ACTIVE)
  isActive         Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                    User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                  Campus                      @relation(fields: [campusId], references: [id])
  batch                   Batch?                      @relation(fields: [batchId], references: [id])
  class                   Class?                      @relation(fields: [classId], references: [id])
  house                   House?                      @relation(fields: [houseId], references: [id])
  parents                 Parent[]
  guardians               Guardian[]
  attendance              Attendance[]
  feePayments             FeePayment[]
  feeInvoices             FeeInvoice[]
  penaltyAssessments      PenaltyAssessment[]
  results                 Result[]
  achievements            Achievement[]
  certificates            Certificate[]
  sportEvents             SportEventParticipant[]
  houseCaptainOf          House[]                     @relation("HouseCaptain")
  houseViceCaptainOf      House[]                     @relation("HouseViceCaptain")
  feedbacks               TeacherFeedback[]
  feedbackSubmissions     StudentFeedbackSubmission[]
  taskResults             TaskResult[]
  leaveRequests           StudentLeaveRequest[]
  enrollments             StudentEnrollment[]
  promotionRecords        PromotionRecord[]
  enrollmentTypeAuditLogs EnrollmentTypeAuditLog[]
  targetAssignments       TargetAssignment[]
  termResults             TermResult[]
  dailyPerformanceScores  DailyPerformanceScore[]
  examDateSheetOverrides  ExamDateSheetOverride[]

  waitingListEntries WaitingListEntry[]
  @@index([userId])
  @@index([campusId])
  @@index([batchId])
  @@index([classId])
  @@index([enrollmentStatus])
  @@index([feeStatus])
  @@index([dateOfBirth]) // WHY: Daily birthday cron queries on this column
}

// ─────────────────────────────────────────────────────────────────────────────
// ADMISSION REQUESTS
// ─────────────────────────────────────────────────────────────────────────────

model AdmissionRequest {
  id String @id @default(cuid())

  // ── Section 1: Student Identity ──────────────────────────────────────────
  firstName  String
  lastName   String
  fullNameAr String? // Full four-part Arabic legal name
  fullNameEn String? // Full four-part English legal name (for certificates)
  fatherName String
  motherName String? // Mother's full name
  dateOfBirth DateTime
  gender      Gender
  bloodGroup  String?
  nationality String   @default("Egyptian")

  // ── Section 2: Contact & Address ─────────────────────────────────────────
  address          String
  city             String
  phoneNumber      String
  emergencyContact String
  email            String?

  // ── Section 3: Guardian / Parent Details ─────────────────────────────────
  passportPhotoUrl     String?
  guardianFirstName    String?
  guardianLastName     String?
  guardianPhoneNumber  String?
  guardianEmail        String?
  guardianRelationship String? // Father | Mother | Brother | Uncle | Other
  fatherPhoneNumber    String?
  fatherOccupation     String? // Employment / profession of father
  motherPhoneNumber    String?
  motherOccupation     String?
  // BOTH_ALIVE | FATHER_DECEASED | MOTHER_DECEASED | BOTH_DECEASED | DIVORCED
  parentStatus         String? @default("BOTH_ALIVE")

  // ── Section 4: School & Prior Background ──────────────────────────────────
  schoolName                 String? // Current regular school the student attends
  regularSchoolGrade         String? // Grade/year in their regular school
  priorProgrammingExperience String? // Free-text note on prior programming/robotics experience

  // ── Section 5: Documents & Medical ───────────────────────────────────────
  medicalNotes String? // Optional: allergies, conditions staff should be aware of — never required

  // Sibling already enrolled at this academy
  hasSiblingAtAcademy Boolean @default(false)
  siblingName         String? // Full name of sibling here
  siblingClass        String? // Class / section of sibling

  // ── Section 6: Academic Preference ───────────────────────────────────────
  preferredCampusId       String?
  preferredBatchId        String?
  preferredShift          SessionShift?
  preferredClassSectionId String?
  deliveryMode            ClassDeliveryMode @default(PHYSICAL)

  admissionFee       Decimal @default(0) @db.Decimal(10, 2)
  requestedCourseFee Decimal @default(0) @db.Decimal(10, 2)
  totalAcademicFee   Decimal @default(0) @db.Decimal(10, 2)

  // ── Declaration & Referral ───────────────────────────────────────────────
  sourceOfInfo String? // How did they hear about us
  /// Phase D: referral code or the referring parent's phone typed on the form
  referralCode String?

  // WHY: We store server-side confirmation that T&C was accepted; the boolean
  //      is set by the API only after the checkbox passes Zod validation.
  //      Timestamp enables audit trail for regulatory compliance.
  termsAccepted   Boolean   @default(false)
  termsAcceptedAt DateTime? // UTC timestamp of acceptance

  // ── Admin / Workflow ─────────────────────────────────────────────────────
  status        AdmissionStatus @default(PENDING)
  reviewedBy    String? // Admin User ID who approved/declined
  adminComments String? // Decline reason or admin notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  employeeId      String   @unique
  firstName       String
  lastName        String
  cnic            String   @unique
  dateOfBirth     DateTime
  gender          Gender
  qualification   String
  specialization  String?
  experienceYears Int      @default(0)
  joiningDate     DateTime

  phoneNumber      String
  email            String @unique
  address          String
  city             String
  emergencyContact String

  campusId       String
  batchId        String?
  designation    String // "Teacher", "Senior Teacher", "Head Teacher"
  monthlySalary  Decimal? @db.Decimal(10, 2)
  // Default group-pay rule, applied to any group this teacher is assigned to
  // that doesn't have its own override on the SubjectOffering. Same
  // combinable three components as the group-level override.
  defaultFixedAmount             Decimal? @db.Decimal(10, 2)
  defaultPercentOfStudentPayment Decimal? @db.Decimal(5, 2)
  defaultPerSessionAmount        Decimal? @db.Decimal(10, 2)
  profilePicture String? // Cloudinary URL
  isActive       Boolean  @default(true)

  // Performance/House assignment for teachers (optional)
  houseId String?
  house   House?  @relation("HouseTeachers", fields: [houseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                   User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus                 Campus                     @relation(fields: [campusId], references: [id])
  batch                  Batch?                     @relation(fields: [batchId], references: [id])
  classes                ClassTeacher[]
  subjects               SubjectTeacher[]
  attendance             TeacherAttendance[]
  penaltyAssessments     PenaltyAssessment[]
  payAdjustments         TeacherPayAdjustment[]
  qualifiedSubjects      TeacherQualifiedSubject[]
  credentials            TeacherCredential[]
  absences               TeacherAbsence[]
  substitutingFor        SubstituteAssignment[] @relation("OriginalTeacherAssignments")
  substituteAssignments  SubstituteAssignment[] @relation("SubstituteTeacherAssignments")
  timetable              Timetable[]
  tasks                  ClassTask[]
  changeRequests         TimetableChangeRequest[]
  feedbacks              TeacherFeedback[]
  monthlyFeedbackAnswers FeedbackAnswer[]
  applications           TeacherApplication[]
  studentLeaves          StudentLeaveRequest[]
  availabilities         TeacherAvailability[]
  subjectOfferings       SubjectOffering[]
  timetableSlots         TimetableSlot[]
  sectionAssignments     TeacherSectionAssignment[]
  teacherDocuments       TeacherDocument[]
  TermResult             TermResult[]

  @@index([userId])
  @@index([campusId])
  @@index([employeeId])
}

model Admin {
  id         String   @id @default(cuid())
  userId     String   @unique
  firstName  String
  lastName   String
  campusId   String
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id])

  @@index([campusId])
}

// WHY campusId required: Branch Managers are ADMIN-equivalent but strictly
// scoped to a single campus — see lib/rbac.ts and the campus-scoping checks
// throughout app/api/** that key off session.user.campusId.
model BranchManager {
  id         String   @id @default(cuid())
  userId     String   @unique
  firstName  String
  lastName   String
  campusId   String
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id])

  @@index([campusId])
}

// WHY campusId required: Secretaries handle front-desk operations (student
// registration, attendance, fee collection) for a single campus.
model Secretary {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String?
  campusId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus @relation(fields: [campusId], references: [id])

  @@index([campusId])
}

// WHY campusId optional: Marketing staff work on Leads/Admissions which can
// span multiple campuses; leave campusId nullable for future scoping.
model MarketingStaff {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  phoneNumber String?
  campusId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id])

  @@index([campusId])
}

model Parent {
  id           String   @id @default(cuid())
  userId       String   @unique
  firstName    String
  lastName     String
  cnic         String   @unique
  phoneNumber  String
  email        String?
  occupation   String?
  relationship String // "Father", "Mother", "Guardian"
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([userId])
}

model Guardian {
  id           String   @id @default(cuid())
  userId       String   @unique
  firstName    String
  lastName     String
  phoneNumber  String   @unique
  email        String?
  relationship String
  /// Phase D: the parent's referral code (TN-REF-…), created the first time it is shown
  referralCode String?  @unique
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  students Student[]

  @@index([userId])
}

model Accountant {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String
  lastName    String
  employeeId  String   @unique
  phoneNumber String
  // WHY campusId: Accountants are campus-scoped; cross-campus financial data must never be exposed unless campusId is null (All Campuses)
  campusId    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus   Campus?   @relation(fields: [campusId], references: [id])
  expenses Expense[]

  @@index([userId])
  @@index([campusId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

model Class {
  id           String       @id @default(cuid())
  name         String // "Class 1", "Class 9-A Morning", etc.
  grade        Int // 1–12
  section      String? // "A", "B", "C"
  // WHY shift: Academy runs Morning and Evening coaching sessions.
  // A Morning class and Evening class of the same grade/section are separate entities.
  shift        SessionShift @default(MORNING)
  campusId     String
  batchId      String?
  academicYear String // "2024-2025"
  capacity     Int          @default(40)
  roomNumber   String?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  campus        Campus                @relation(fields: [campusId], references: [id])
  batch         Batch?                @relation(fields: [batchId], references: [id])
  students      Student[]
  teachers      ClassTeacher[]
  subjects      Subject[]
  timetable     Timetable[]
  exams         Exam[]
  attendance    Attendance[]
  announcements Announcement[]
  tasks         ClassTask[]
  feedbacks     TeacherFeedback[]
  leaveRequests StudentLeaveRequest[]

  // shift included in unique key: 9-A Morning and 9-A Evening are separate classes
  @@unique([grade, section, campusId, academicYear, shift])
  @@index([campusId])
  @@index([batchId])
  @@index([academicYear])
  @@index([shift])
}

model ClassTeacher {
  id             String   @id @default(cuid())
  classId        String
  teacherId      String
  // WHY: isClassTeacher flag distinguishes the homeroom teacher from subject teachers
  isClassTeacher Boolean  @default(false)
  academicYear   String
  createdAt      DateTime @default(now())

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, teacherId, academicYear])
  @@index([classId])
  @@index([teacherId])
}

model Subject {
  id           String   @id @default(cuid())
  name         String // "Mathematics", "Urdu", "Physics"
  code         String // "MATH", "URD", "PHY"
  classId      String
  totalMarks   Int      @default(100)
  passingMarks Int      @default(33)
  isElective   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class    Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  teachers SubjectTeacher[]
  results  ResultDetail[]
  tasks    ClassTask[]

  @@unique([code, classId])
  @@index([classId])
}

model SubjectTeacher {
  id        String   @id @default(cuid())
  subjectId String
  teacherId String
  createdAt DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  // WHY shift: A student may attend Morning OR Evening class on the same day.
  // Including shift in the unique key allows separate records per session.
  shift     SessionShift     @default(MORNING)
  markedBy  String // Teacher user ID
  remarks   String?
  createdAt DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  // shift added to prevent duplicate records per session per day
  @@unique([studentId, classId, date, shift])
  @@index([classId, date, shift]) // Primary query pattern: attendance for class X on date Y for shift Z
  @@index([studentId])
  @@index([shift])
}

model TeacherAttendance {
  id               String                     @id @default(cuid())
  teacherId        String
  date             DateTime                   @db.Date
  status           AttendanceStatus           @default(PRESENT)
  // WHY shift: A teacher may be present for Morning but absent for Evening, or vice versa.
  shift            SessionShift               @default(MORNING)
  remarks          String?
  // HR attendance extensions (check-in based lateness penalties)
  checkInTime      DateTime?
  checkOutTime     DateTime?
  hrStatus         TeacherHrAttendanceStatus?
  lateMinutes      Int                        @default(0)
  penaltyAmount    Decimal                    @default(0) @db.Decimal(10, 2)
  isPenaltyApplied Boolean                    @default(false)
  createdAt        DateTime                   @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  // shift included: a teacher can have separate attendance for each session per day
  @@unique([teacherId, date, shift])
  @@index([teacherId])
  @@index([shift])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEE MANAGEMENT — ACID-critical section
// WHY: All fee mutations MUST run inside Prisma $transaction to prevent
//      partial updates that corrupt the student's financial record
// ─────────────────────────────────────────────────────────────────────────────

model FeeInvoice {
  id            String        @id @default(cuid())
  // ESA/24-25/05876 — generated in application layer
  challanNumber String        @unique
  studentId     String
  month         String // "May 2025"
  academicYear  String // "2024-2025"
  dueDate       DateTime
  subtotal      Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  lateFee       Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)
  status        InvoiceStatus @default(ISSUED)
  pdfUrl        String? // Cloudinary URL of generated challan PDF
  notes         String?
  issuedBy      String // Admin user ID

  // Payment Proof & Multi-Bank Fields
  bankAccounts     String? // Semicolon-separated account list e.g. "Allied Bank: 1234; HBL: 5678"
  proofUrl         String? // Cloudinary receipt image URL
  proofRemarks     String? // Student/guardian deposit comments
  proofUploadedAt  DateTime?
  proofStatus      String? // "PENDING", "APPROVED", "REJECTED"
  // What the guardian said they paid when uploading proof — only used when
  // the linked group allows installments; the accountant can still adjust
  // this when approving.
  proofDeclaredAmount Decimal? @db.Decimal(10, 2)
  penaltyAmount    Decimal   @default(0) @db.Decimal(10, 2)
  /// Money given back on this invoice (approved refunds). Net paid = paidAmount - refundedAmount.
  refundedAmount   Decimal   @default(0) @db.Decimal(10, 2)
  isPenaltyApplied Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Optional link to a group's billing cycle (a month, or a full level),
  // when this invoice was generated from the Groups system rather than the
  // legacy general monthly-invoice flow. Nullable so nothing existing breaks.
  classSectionId String?
  levelId        String?
  cycleNumber    Int? // which billing month this covers; null for a one-time FULL_LEVEL invoice

  student            Student             @relation(fields: [studentId], references: [id])
  items              FeeItem[]
  payments           FeePayment[]
  penaltyAssessments PenaltyAssessment[]
  classSection       ClassSection?       @relation(fields: [classSectionId], references: [id])
  level              Level?              @relation(fields: [levelId], references: [id])

  @@index([studentId])
  @@index([status])
  @@index([month, academicYear])
  @@index([classSectionId])
}

model FeeItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String // "Tuition Fee", "Computer Lab", "Sports Fee"
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model FeePayment {
  id            String        @id @default(cuid())
  invoiceId     String
  studentId     String
  amount        Decimal       @db.Decimal(10, 2)
  paymentDate   DateTime      @default(now())
  paymentMethod String // "Cash", "Bank Transfer", "Online"
  transactionId String? // Bank reference number
  status        PaymentStatus @default(COMPLETED)
  receivedBy    String // Accountant/Admin user ID
  remarks       String?
  /// Receipt number TN-RCPT-YYYY-NNNNN (lib/fees/record-payment.ts). Null for payments recorded before 2026-10-02.
  receiptNumber String?       @unique @db.VarChar(30)
  /// STAFF | PROOF | ONLINE | WALLET — how the payment came in.
  source        String?       @db.VarChar(10)
  createdAt     DateTime      @default(now())

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])
  student Student    @relation(fields: [studentId], references: [id])

  @@index([invoiceId])
  @@index([studentId])
  @@index([paymentDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// ACADEMIC RESULTS & EXAMS
// ─────────────────────────────────────────────────────────────────────────────

model Exam {
  id           String   @id @default(cuid())
  name         String // "Mid-Term", "Final", "Unit Test"
  classId      String
  academicYear String
  startDate    DateTime
  endDate      DateTime
  totalMarks   Int      @default(100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class   Class    @relation(fields: [classId], references: [id])
  results Result[]

  @@index([classId])
  @@index([academicYear])
}

model Result {
  id            String   @id @default(cuid())
  studentId     String
  examId        String
  totalMarks    Int
  obtainedMarks Int
  percentage    Decimal  @db.Decimal(5, 2)
  grade         String // "A+", "A", "B", "C", "D", "F"
  position      Int? // Class rank
  isPassed      Boolean
  remarks       String?
  pdfUrl        String? // Cloudinary URL of result card
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student        @relation(fields: [studentId], references: [id])
  exam    Exam           @relation(fields: [examId], references: [id])
  details ResultDetail[]

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
}

model ResultDetail {
  id            String   @id @default(cuid())
  resultId      String
  subjectId     String
  totalMarks    Int
  obtainedMarks Int
  grade         String
  isPassed      Boolean
  createdAt     DateTime @default(now())

  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE
// ─────────────────────────────────────────────────────────────────────────────

model Timetable {
  id           String       @id @default(cuid())
  classId      String
  teacherId    String
  dayOfWeek    Int // 0=Monday, 5=Saturday
  startTime    String // "08:00"
  endTime      String // "08:45"
  subjectName  String
  academicYear String
  // WHY shift: Morning and Evening sessions have independent timetable slots
  shift        SessionShift @default(MORNING)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class          Class                    @relation(fields: [classId], references: [id])
  teacher        Teacher                  @relation(fields: [teacherId], references: [id])
  changeRequests TimetableChangeRequest[]

  @@index([classId])
  @@index([teacherId])
  @@index([shift])
}

// ─────────────────────────────────────────────────────────────────────────────
// SPORTS & ACHIEVEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model SportEvent {
  id            String   @id @default(cuid())
  name          String
  houseId       String
  date          DateTime
  category      String // "Cricket", "Football", "Athletics"
  result        String? // "1st Place", "Runner-up"
  pointsAwarded Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  house        House                   @relation(fields: [houseId], references: [id])
  participants SportEventParticipant[]

  @@index([houseId])
}

model SportEventParticipant {
  id          String   @id @default(cuid())
  eventId     String
  studentId   String
  role        String // "Player", "Captain", "Volunteer"
  performance String?
  createdAt   DateTime @default(now())

  event   SportEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student    @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
}

model Achievement {
  id          String   @id @default(cuid())
  studentId   String
  title       String
  description String?
  date        DateTime
  category    String // "Academic", "Sports", "Arts", "Leadership"
  issuedBy    String
  pdfUrl      String? // Cloudinary URL of achievement certificate
  createdAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// DOCUMENTS & CERTIFICATES
// ─────────────────────────────────────────────────────────────────────────────

// Records every certificate PDF export so ceremonies can be reproduced and
// audited later ("what did we print for the 2026 ceremony, in what order?").
model CertificatePrintBatch {
  id             String   @id @default(cuid())
  label          String // Free-text, e.g. "Annual Ceremony 2026 — Robotics"
  // GROUPED = one PDF per course/level; COMBINED = a single PDF with all
  // certificates ordered by course then level.
  mode           String   @default("GROUPED")
  certificateIds Json // Ordered array of certificate IDs included in this batch
  totalCount     Int
  printedBy      String // Admin user ID
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model Certificate {
  id         String          @id @default(cuid())
  studentId  String
  type       CertificateType
  title      String
  issuedDate DateTime        @default(now())
  expiryDate DateTime?
  pdfUrl     String? // Cloudinary URL
  issuedBy   String // Admin user ID
  remarks    String?
  createdAt  DateTime        @default(now())

  // ── Authenticity & verification ──────────────────────────────────────────
  // Human-readable, publicly-quotable ID e.g. "TN-CERT-2026-00001".
  // Distinct from the internal cuid `id` — this is the one printed on the
  // certificate and encoded in the QR code / verification URL.
  certificateNumber String  @unique
  qrCodeUrl         String? @db.LongText // Base64 QR code image (data URL)
  status            CertificateStatus @default(VALID)
  revokedAt         DateTime?
  revokedBy         String? // Admin/Super Admin user ID
  revokedReason     String?

  // ── Level-completion certificate fields ──────────────────────────────────
  templateId   String? // Which CertificateTemplate design to render with
  subjectId    String? // Which course/level this certificate is for
  levelResultId String? @unique // The graded result that triggered this certificate
  // WHY blur-by-default: certificates are handed out formally at a ceremony;
  // student/guardian should see "earned" state before the actual artwork is revealed.
  isRevealed   Boolean   @default(false)
  revealedAt   DateTime?
  revealedBy   String? // Admin/Super Admin user ID who revealed it

  student      Student              @relation(fields: [studentId], references: [id])
  template     CertificateTemplate? @relation(fields: [templateId], references: [id])
  subject      AcademicSubject?     @relation(fields: [subjectId], references: [id])
  levelResult  StudentLevelResult?  @relation(fields: [levelResultId], references: [id])

  @@index([studentId])
  @@index([type])
  @@index([subjectId])
  @@index([isRevealed])
  @@index([certificateNumber])
  @@index([status])
}

enum CertificateStatus {
  VALID
  REVOKED
}

// WHY subjectId nullable: a null row is the global default used for any
// course that has no override. Looking up a course's active config means
// "try the row with this subjectId first, fall back to the null row."
model CourseGradingConfig {
  id               String   @id @default(cuid())
  subjectId        String?  @unique // null = global default template
  homeworkWeight   Float    @default(20) // % weight of homework/task completion
  taskWeight       Float    @default(20) // % weight of per-session tasks
  instructorWeight Float    @default(20) // % weight of instructor's own evaluation
  projectWeight    Float    @default(25) // % weight of final project
  mcqWeight        Float    @default(15) // % weight of MCQ exam
  passThreshold    Float    @default(60) // Minimum final % required to pass the level
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  subject AcademicSubject? @relation(fields: [subjectId], references: [id])

  @@index([subjectId])
}

// One row per student per course/level attempt — holds the raw component
// scores (each stored as a 0-100 percentage of that component), the computed
// final score, and the pass/fail outcome.
model StudentLevelResult {
  id                  String   @id @default(cuid())
  studentEnrollmentId String
  subjectId           String

  // Raw component scores (0-100 scale each)
  homeworkScore   Float? // Source: MANUAL for now, later can be MOODLE
  homeworkSource  String  @default("MANUAL")
  taskScore       Float?
  taskSource      String  @default("MANUAL")
  instructorScore Float?
  instructorSource String @default("MANUAL")
  projectScore    Float?
  projectSource   String  @default("MANUAL")
  mcqScore        Float?
  mcqSource       String  @default("MANUAL")

  finalScore    Float? // Weighted result computed from the components above
  passed        Boolean? // Null until all components are entered and computed
  instructorFeedback String? // Required before the result can be finalized

  computedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  subject           AcademicSubject   @relation(fields: [subjectId], references: [id])
  certificate       Certificate?

  @@unique([studentEnrollmentId, subjectId])
  @@index([subjectId])
  @@index([passed])
}

// An uploaded certificate background + the positions/styling of the dynamic
// text fields (student name, course, date, QR code, etc.) drawn on top of it.
model CertificateTemplate {
  id              String   @id @default(cuid())
  name            String
  backgroundUrl   String // Cloudinary URL of the uploaded design
  widthPx         Int      @default(1600)
  heightPx        Int      @default(1131) // A4 landscape @ ~200dpi default
  // Array of { key, label, x, y, fontSizePx, fontFamily, color, align, bold }
  // key is one of: studentName, courseName, levelName, issueDate, certificateId, qrCode
  fieldLayout     Json
  isDefault       Boolean  @default(false)
  createdBy       String // Admin user ID
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  certificates Certificate[]
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION & CALENDAR
// ─────────────────────────────────────────────────────────────────────────────

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  targetRole  Role? // NULL = all roles
  campusId    String? // NULL = all campuses
  batchId     String?
  classId     String?
  isActive    Boolean   @default(true)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdBy   String // Admin user ID or Teacher user ID
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  batch Batch? @relation(fields: [batchId], references: [id])
  class Class? @relation(fields: [classId], references: [id])

  @@index([targetRole])
  @@index([campusId])
  @@index([batchId])
  @@index([classId])
  @@index([publishedAt])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime
  eventType   String // "Holiday", "Exam", "Sports", "Ceremony", "Other"
  campusId    String? // NULL = all campuses
  isActive    Boolean  @default(true)
  createdBy   String // Admin user ID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
  @@index([campusId])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOGGING
// WHY: Every mutation must be traceable for compliance and debugging.
//      This table is append-only — never update or delete rows.
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String // "CREATE", "UPDATE", "DELETE", "LOGIN", "LOGOUT"
  entityType String // "Student", "FeePayment", etc.
  entityId   String?
  // WHY Json: captures before/after state without schema coupling
  changes    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
}

model RolePermission {
  id          String   @id @default(cuid())
  role        Role
  resource    String
  action      String
  isEnabled   Boolean  @default(true)
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])

  @@unique([role, resource, action])
  @@index([role])
  @@index([resource])
  @@index([action])
}

model RoleAssumption {
  id           String    @id @default(cuid())
  requesterId  String
  originalRole Role
  assumedRole  Role
  reason       String?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  requester User @relation(fields: [requesterId], references: [id])

  @@index([requesterId])
  @@index([assumedRole])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAVES, COMPLAINTS, STUDENT QUERIES & SALARIES
// ─────────────────────────────────────────────────────────────────────────────

enum LeaveType {
  CASUAL
  SICK
  MATERNITY
  EMERGENCY
  OTHER
}

model LeaveRequest {
  id                    String    @id @default(cuid())
  applicantId           String // References User.id
  applicantName         String
  applicantRole         Role
  leaveType             LeaveType @default(CASUAL)
  startDate             DateTime
  endDate               DateTime
  reason                String
  status                String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  remarks               String?
  reviewedBy            String? // User.id of reviewer (Admin or Teacher)
  reviewedName          String?
  // WHY: Guardians apply on behalf of their child — ties the leave to a specific student
  onBehalfOfStudentId   String?
  onBehalfOfStudentName String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([applicantId])
  @@index([status])
  @@index([onBehalfOfStudentId])
}

model Complaint {
  id              String   @id @default(cuid())
  complainantId   String // References User.id
  complainantName String
  complainantRole Role
  title           String
  description     String
  status          String   @default("PENDING") // legacy "PENDING"/"RESOLVED"; phase D: NEW | IN_PROGRESS | RESOLVED | CLOSED
  remarks         String?
  /// Phase D (docs/design-phase-d.md) — all optional / defaulted (additive)
  number          String?   @unique
  kind            String    @default("COMPLAINT") @db.VarChar(10) // COMPLAINT | SUGGESTION | PRAISE
  topic           String?   @db.VarChar(12) // INSTRUCTOR | SCHEDULE | PAYMENT | PLACE | SESSION | OTHER
  body            String?   @db.Text
  studentId       String?
  classSectionId  String?
  campusId        String?
  source          String    @default("PORTAL") @db.VarChar(12) // PORTAL | PHONE | AUTO_RATING
  assignedToId    String?
  dueAt           DateTime?
  firstReplyAt    DateTime?
  escalatedAt     DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  satisfied       Boolean?
  handlingRating  Int?
  resolvedBy      String? // Admin User.id
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([complainantId])
  @@index([status])
  @@index([campusId, status])
}

model StudentQuery {
  id          String   @id @default(cuid())
  studentId   String // Student User.id
  studentName String
  teacherId   String // Teacher User.id
  teacherName String
  subject     String
  queryText   String
  status      String   @default("PENDING") // "PENDING", "ANSWERED"
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

model SalarySlip {
  id                String    @id @default(cuid())
  // WHY: employeeId is User.id — consistent with AuditLog.userId for cross-table lookups
  employeeId        String
  employeeName      String
  employeeRole      Role
  employeeNumber    String? // HR employee number
  department        String?
  designation       String?
  month             String // "June 2026"
  salaryPeriodStart DateTime
  salaryPeriodEnd   DateTime
  issueDate         DateTime  @default(now())
  basicSalary       Decimal   @db.Decimal(10, 2)
  overtimeAmount    Decimal   @default(0) @db.Decimal(10, 2)
  // totalAdditions = basicSalary + overtimeAmount + any extra; stored denormalized for export
  totalAdditions    Decimal   @default(0) @db.Decimal(10, 2)
  lunchDues         Decimal   @default(0) @db.Decimal(10, 2)
  totalDeductions   Decimal   @default(0) @db.Decimal(10, 2)
  // netSalary enforced: basicSalary + overtimeAmount - lunchDues - totalDeductions
  netSalary         Decimal   @db.Decimal(10, 2)
  bankName          String?
  accountNumber     String?
  paymentSource     String? // "Cash" | "Bank Transfer" | "Cheque"
  // WHY Json: Account Manager can add custom line items (e.g. "Travel Allowance: 500")
  // Stored as [{label: string, value: number, isDeduction: boolean}]
  customFields      Json?
  status            String    @default("ISSUED") // ISSUED | PAID | CANCELLED
  approvalStatus    String    @default("PENDING") // PENDING | APPROVED | REJECTED | LEGACY
  approvalNote      String?
  issuedById        String?
  approvedById      String?
  issuedAsRole      String?
  approvedAsRole    String?
  paymentReference  String?
  paymentDate       DateTime?
  notes             String?
  generatedBy       String // Accountant User.id
  // WHY isDeleted: Financial records are never hard-deleted (audit requirement)
  isDeleted         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  editLogs           SalarySlipEditLog[]
  authorizations     SalaryAuthorization[]
  penaltyAssessments PenaltyAssessment[]

  @@index([employeeId])
  @@index([month])
  @@index([generatedBy])
  @@index([isDeleted])
}

model SalaryAuthorization {
  id           String   @id @default(cuid())
  salarySlipId String
  issuerId     String
  approverId   String
  issuerRole   String
  approverRole String
  status       String   @default("PENDING")
  reason       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salarySlip SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
  @@index([issuerId])
  @@index([approverId])
  @@index([status])
}

// WHY separate audit log: SalarySlip edits are retroactive financial changes
// that require point-in-time before/after state for regulatory review
model SalarySlipEditLog {
  id           String   @id @default(cuid())
  salarySlipId String
  editedById   String // User.id of accountant who made the change
  beforeState  Json // Full salary slip state before edit
  afterState   Json // Full salary slip state after edit
  reason       String
  createdAt    DateTime @default(now())

  salarySlip SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
  @@index([editedById])
}

// ─────────────────────────────────────────────────────────────────────────────
// NEW TEACHER MODULE EXPANSION MODELS
// ─────────────────────────────────────────────────────────────────────────────

model ClassTask {
  id             String    @id @default(cuid())
  title          String
  description    String?
  type           TaskType
  dueDate        DateTime?
  maxMarks       Int       @default(100)
  classId        String
  classSectionId String?
  subjectId      String
  teacherId      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  class        Class         @relation(fields: [classId], references: [id])
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  subject      Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher      Teacher       @relation(fields: [teacherId], references: [id])
  results      TaskResult[]

  @@index([classId])
  @@index([classSectionId])
  @@index([subjectId])
  @@index([teacherId])
}

model TaskResult {
  id            String   @id @default(cuid())
  taskId        String
  studentId     String
  obtainedMarks Decimal  @db.Decimal(5, 2)
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  task    ClassTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([taskId, studentId])
}

// GradingSchema removed: replaced by teacher-controlled TermResult/SubjectResult flow.
// Teachers now enter marks directly into TermResult; grade boundaries are derived
// from the institution-wide AcademicGradingScheme (academic engine) or the
// performanceBatch field on TermResult. No per-teacher schema builder is needed.

model TeacherFeedback {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  classId   String
  month     String // "June 2026"
  rating    Int // 1-5
  comments  String?
  createdAt DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id])

  @@unique([teacherId, studentId, month])
}

model TeacherApplication {
  id          String          @id @default(cuid())
  teacherId   String
  type        ApplicationType
  title       String
  description String
  status      String          @default("PENDING") // PENDING, APPROVED, REJECTED
  adminReply  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
}

model StudentLeaveRequest {
  id        String   @id @default(cuid())
  studentId String
  teacherId String // Approving/reviewing teacher (Class Teacher)
  classId   String
  startDate DateTime
  endDate   DateTime
  reason    String
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])
  class   Class   @relation(fields: [classId], references: [id])

  @@index([studentId])
  @@index([teacherId])
  @@index([status])
}

model TeacherAvailability {
  id            String   @id @default(cuid())
  teacherId     String
  dayOfWeek     Int // 0=Monday, 6=Sunday
  arrivalTime   String // "08:00"
  departureTime String // "14:00"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, dayOfWeek])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// WHY: Push real-time in-app alerts to students/teachers/admins without
//      requiring a WebSocket server. Polled by the client every 30s.
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // RESULT_PUBLISHED | ATTENDANCE_ALERT | TIMETABLE_CHANGE | GENERAL
  isRead    Boolean  @default(false)
  relatedId String? // optional FK reference (examId, timetableId, etc.)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
}

// ─────────────────────────────────────────────────────────────────────────────
// TIMETABLE CHANGE REQUESTS
// WHY: Teachers cannot modify timetable directly. They submit a change request
//      that an Admin must approve. Keeps timetable authoritative and auditable.
// ─────────────────────────────────────────────────────────────────────────────

model TimetableChangeRequest {
  id              String    @id @default(cuid())
  // WHY nullable FK pair: supports both legacy `Timetable` and new `TimetableSlot`.
  // Exactly one is non-null. slotSource tells consumers which table to read.
  timetableId     String? // FK → Timetable (legacy)
  timetableSlotId String? // FK → TimetableSlot (academic engine)
  slotSource      String    @default("legacy") // "legacy" | "engine"
  teacherId       String
  requestedBy     String // userId of requesting teacher
  reason          String
  // Snapshot of original slot at time of request (for audit/display, denormalized)
  originalSubject String?
  originalDay     Int?
  originalStart   String?
  originalEnd     String?
  originalClass   String?
  // Proposed changes (null = keep existing)
  newDayOfWeek    Int?
  newStartTime    String?
  newEndTime      String?
  newSubjectName  String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  adminReply      String?
  reviewedBy      String? // userId of admin who reviewed
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  timetable     Timetable?     @relation(fields: [timetableId], references: [id], onDelete: SetNull)
  timetableSlot TimetableSlot? @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  teacher       Teacher        @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([status])
  @@index([timetableId])
  @@index([timetableSlotId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PRODUCTION ACADEMIC ENGINE (canonical yearly operations)
// Static: Campus → Shift → Batch → ClassSection → Subject → Teacher
// Dynamic: AcademicYear → Enrollment → Timetable → Attendance → Results
// ─────────────────────────────────────────────────────────────────────────────

model AcademicYear {
  id        String   @id @default(cuid())
  name      String   @unique // "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())

  enrollments               StudentEnrollment[]
  timetableSlots            TimetableSlot[]
  gradingSchemes            AcademicGradingScheme[]
  subjectOfferings          SubjectOffering[]
  promotions                PromotionRecord[]
  timetableTemplates        TimetableTemplate[]
  teacherSectionAssignments TeacherSectionAssignment[]

  @@index([isActive])
}

model Shift {
  id               String       @id @default(cuid())
  code             SessionShift @unique
  name             String
  startTime        String // "09:00"
  endTime          String // "13:00"
  lateGraceMinutes Int          @default(15)
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  classSections      ClassSection[]
  timetableTemplates TimetableTemplate[]
}

model Room {
  id        String   @id @default(cuid())
  campusId  String
  name      String
  capacity  Int      @default(40)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  campus         Campus          @relation(fields: [campusId], references: [id])
  timetableSlots TimetableSlot[]

  @@unique([campusId, name])
  @@index([campusId])
}

model ClassSection {
  id             String            @id @default(cuid())
  campusId       String
  batchId        String
  shiftId        String
  className      String            @db.VarChar(50) // "Class 9"
  sectionName    String            @db.VarChar(10) // "A"
  grade          Int?
  deliveryMode   ClassDeliveryMode @default(PHYSICAL)
  capacity       Int               @default(40)
  /// Phase A: most students allowed in the group (null = no limit). Not the old template "capacity".
  maxStudents    Int?
  /// LMS (L1): the curriculum version this group follows (pinned when it starts; null = newest published)
  curriculumEditionId String?
  /// LMS L2: how lessons open for this group (ALL | SCHEDULE | ATTENDANCE | MANUAL | PREVIOUS); null = the level's / company default
  lessonUnlockMode    String?           @db.VarChar(12)
  curriculumMode CurriculumMode    @default(FIXED)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // Which specific Level (of which Course) this Group is teaching. Nullable —
  // existing groups keep working unassigned until an admin sets it, and the
  // legacy Class/Subject workflow never needs this field at all.
  levelId        String?
  status         GroupStatus       @default(ACTIVE)
  completedAt    DateTime?
  // When this group's sessions start/are expected to finish, and its weekly
  // recurring schedule — kept simple (Json array of {dayOfWeek, time}) for
  // now; a full Timetable integration is planned separately later.
  startDate      DateTime?
  expectedEndDate DateTime?
  scheduleSlots  Json?
  // Tracks progress through the current subscription cycle. For a MONTHLY
  // level, currentCycleNumber counts which billing month the group is on.
  // For a FULL_LEVEL level, "finishing the cycle" instead advances levelId
  // to the next level and this resets to 1.
  currentCycleNumber    Int       @default(1)
  currentCycleStartDate DateTime?
  // Payment-gating settings for this group specifically.
  requireFullPaymentToStart Boolean @default(false)
  partialPaymentCounts      Boolean @default(false)
  installmentsAllowed       Boolean @default(false)

  cycleLogs GroupCycleLog[]
  invoices  FeeInvoice[]
  payAdjustments TeacherPayAdjustment[]
  absences TeacherAbsence[]
  substituteAssignments SubstituteAssignment[]
  cancelledSessions CancelledSession[]

  campus                    Campus                     @relation(fields: [campusId], references: [id])
  batch                     Batch                      @relation(fields: [batchId], references: [id])
  shift                     Shift                      @relation(fields: [shiftId], references: [id])
  level                     Level?                     @relation(fields: [levelId], references: [id])
  enrollments               StudentEnrollment[]
  subjectOfferings          SubjectOffering[]
  timetableSlots            TimetableSlot[]
  teacherSectionAssignments TeacherSectionAssignment[]
  gradingSchemes            AcademicGradingScheme[]
  electiveGroups            ElectiveGroup[]
  examDateSheets            ExamDateSheet[]
  termResults               TermResult[]
  monthlyMonitoringReports  MonthlyMonitoringReport[]
  tasks                     ClassTask[]

  @@unique([campusId, batchId, shiftId, className, sectionName])
  @@index([campusId])
  @@index([batchId])
  @@index([shiftId])
  @@index([levelId])
}

model StudentEnrollment {
  id             String                   @id @default(cuid())
  studentId      String
  academicYearId String
  classSectionId String
  rollNumber     String
  deliveryMode   ClassDeliveryMode        @default(PHYSICAL)
  status         AcademicEnrollmentStatus @default(ACTIVE)
  enrollmentType EnrollmentType           @default(REGULAR)
  timetableScope Json?
  courseScope    Json?
  promotedFromId String?
  createdAt      DateTime                 @default(now())
  // Why this enrollment was withdrawn, when it was withdrawn automatically
  // rather than by an explicit staff action — e.g. "UNPAID_AUTO" when a
  // student passed the group's payment checkpoint without paying. Lets the
  // UI offer a one-click "Reinstate" specifically for these, separate from a
  // deliberate manual removal (which has no reason and is not reinstated).
  withdrawalReason String?

  student             Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear        AcademicYear                 @relation(fields: [academicYearId], references: [id])
  classSection        ClassSection                 @relation(fields: [classSectionId], references: [id])
  promotedFrom        StudentEnrollment?           @relation("EnrollmentPromotion", fields: [promotedFromId], references: [id])
  promotedTo          StudentEnrollment[]          @relation("EnrollmentPromotion")
  subjectEnrollments  SubjectEnrollment[]
  assessmentScores    AssessmentScore[]
  attendanceRecords   EnrollmentAttendanceRecord[]
  promotionsFrom      PromotionRecord[]            @relation("PromotionFrom")
  promotionsTo        PromotionRecord[]            @relation("PromotionTo")
  feedbackSubmissions StudentFeedbackSubmission[]
  levelResults        StudentLevelResult[]

  @@unique([studentId, academicYearId, classSectionId])
  @@unique([academicYearId, classSectionId, rollNumber])
  @@index([studentId])
  @@index([academicYearId])
  @@index([classSectionId])
}

model SubjectOffering {
  id              String   @id @default(cuid())
  academicYearId  String
  classSectionId  String
  subjectId       String
  teacherId       String?
  isMandatory     Boolean  @default(true)
  electiveGroupId String?
  // WHY per-offering: Different subjects/classes may evaluate daily PST out of
  // different totals (e.g. 10, 20, 50). Configurable at the admin level.
  // Default 20 preserves backward compatibility with existing data.
  maxDailyScore   Int      @default(20)
  createdAt       DateTime @default(now())
  // Group-specific pay override for this teacher — when any of these three
  // is set, it replaces the teacher's own default for THIS group only. All
  // three can be combined (e.g. a flat amount plus a percentage), and any
  // left null simply doesn't contribute to that component.
  overrideFixedAmount              Decimal? @db.Decimal(10, 2)
  overridePercentOfStudentPayment  Decimal? @db.Decimal(5, 2)
  overridePerSessionAmount         Decimal? @db.Decimal(10, 2)

  academicYear           AcademicYear            @relation(fields: [academicYearId], references: [id])
  classSection           ClassSection            @relation(fields: [classSectionId], references: [id])
  subject                AcademicSubject         @relation(fields: [subjectId], references: [id])
  teacher                Teacher?                @relation(fields: [teacherId], references: [id])
  electiveGroup          ElectiveGroup?          @relation(fields: [electiveGroupId], references: [id])
  enrollments            SubjectEnrollment[]
  timetableSlots         TimetableSlot[]
  examDateSheetSlots     ExamDateSheetSlot[]
  examDateSheetOverrides ExamDateSheetOverride[]
  subjectResults         SubjectResult[]
  dailyPerformanceScores DailyPerformanceScore[]
  targetAssignments      TargetAssignment[]

  @@unique([academicYearId, classSectionId, subjectId])
  @@index([classSectionId])
  @@index([teacherId])
}

/// Canonical section-level teacher scope for the active academic year.
/// SubjectOffering remains the authority for subject-level ownership; this
/// relation prevents historical tasks, results, or legacy bridge rows from
/// granting current section access by themselves.
model TeacherSectionAssignment {
  id             String                         @id @default(cuid())
  teacherId      String
  classSectionId String
  academicYearId String
  isClassTeacher Boolean                        @default(false)
  status         TeacherSectionAssignmentStatus @default(ACTIVE)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classSectionId, academicYearId])
  @@index([teacherId, academicYearId, status])
  @@index([classSectionId, academicYearId, status])
}

model AcademicSubject {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  // Optional: which age-based Track this course belongs to. Nullable so
  // existing courses keep working unassigned until an admin categorizes them.
  trackId     String?
  // Where this course sits in its Track's progression (e.g. Beginner=1,
  // Intermediate=2). Only meaningful when trackId is set — used so a group
  // that finishes its course's last level can automatically move on to the
  // next course in the same track.
  trackOrder  Int?

  track          Track?                   @relation(fields: [trackId], references: [id])
  offerings      SubjectOffering[]
  gradingSchemes AcademicGradingScheme[]
  gradingConfigs CourseGradingConfig[]
  levelResults   StudentLevelResult[]
  certificates   Certificate[]
  levels         Level[]
  qualifiedTeachers TeacherQualifiedSubject[]

  waitingListEntries WaitingListEntry[]
  @@index([trackId])
}

/// Age-based grouping above Course (e.g. "Kids 4-7", "Teens 13-17"). A Course
/// belongs to at most one Track.
model Track {
  id          String   @id @default(cuid())
  name        String   @unique
  minAge      Int?
  maxAge      Int?
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  courses AcademicSubject[]
  qualifiedTeachers TeacherQualifiedSubject[]
}

enum LevelPricingType {
  MONTHLY
  FULL_LEVEL
}

/// A Course is split into a configurable number of Levels. Each Level has its
/// own duration (months) and session count — the two together determine the
/// weekly frequency (e.g. 8 sessions over 2 months = once a week) — and its
/// own subscription pricing, since different courses (and different levels
/// within the same course) can have entirely different structures.
model Level {
  id               String            @id @default(cuid())
  subjectId        String
  name             String // "Level 1", "Beginner", etc.
  order            Int // display/progression order within the course
  numberOfMonths   Int
  numberOfSessions Int
  /// LMS L2: default way lessons open for groups of this level; null = company default (lms.settings)
  lessonUnlockMode String?           @db.VarChar(12)
  pricingType      LevelPricingType  @default(MONTHLY)
  monthlyPrice     Float?
  fullLevelPrice   Float?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  subject      AcademicSubject @relation(fields: [subjectId], references: [id])
  classSections ClassSection[]
  invoices      FeeInvoice[]
  qualifiedTeachers TeacherQualifiedSubject[]

  waitingListEntries WaitingListEntry[]
  @@unique([subjectId, order])
  @@index([subjectId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER QUALIFICATIONS, CREDENTIALS, ABSENCE & SUBSTITUTE SYSTEM
// WHY separate from academic engine's SubjectOffering: SubjectOffering means
// "this teacher IS assigned to this group right now". These models track
// "this teacher COULD teach this" (qualification, independent of any
// current assignment) and the absence/substitute workflow built on top.
// ─────────────────────────────────────────────────────────────────────────────

enum TeacherCredentialType {
  QUALIFICATION
  TRAINING
  CERTIFICATE
}

/// What a teacher is qualified to teach. Exactly one of trackId/subjectId/
/// levelId is set per row — trackId covers every course in that track,
/// subjectId covers every level of that course, levelId covers just that
/// one level. Used to filter substitute suggestions.
model TeacherQualifiedSubject {
  id        String   @id @default(cuid())
  teacherId String
  trackId   String?
  subjectId String?
  levelId   String?
  createdAt DateTime @default(now())

  teacher Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  track   Track?           @relation(fields: [trackId], references: [id])
  subject AcademicSubject? @relation(fields: [subjectId], references: [id])
  level   Level?           @relation(fields: [levelId], references: [id])

  @@index([teacherId])
  @@index([trackId])
  @@index([subjectId])
  @@index([levelId])
}

/// A teacher's qualification, professional-development record, or
/// certificate — one unified list, distinguished by type.
model TeacherCredential {
  id           String                @id @default(cuid())
  teacherId    String
  type         TeacherCredentialType
  title        String
  institution  String?
  dateObtained DateTime?             @db.Date
  fileUrl      String?
  createdAt    DateTime              @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

enum AbsenceScope {
  FULL_DAY
  SINGLE_SESSION
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A teacher's request to be absent — a whole day, or one specific group
/// session. Requires admin/manager/secretary approval (gated by the
/// 'teacher_absences' RBAC resource, not a hardcoded role) before any
/// substitute gets suggested. Normal requests need 6+ hours' notice before
/// the affected session; isForceMajeure (severe illness, bereavement)
/// bypasses that, but is flagged for faster admin attention when late.
model TeacherAbsence {
  id              String        @id @default(cuid())
  teacherId       String
  date            DateTime      @db.Date
  scope           AbsenceScope
  classSectionId  String? // set when scope = SINGLE_SESSION
  reason          String
  isForceMajeure  Boolean       @default(false)
  status          AbsenceStatus @default(PENDING)
  requestedAt     DateTime      @default(now())
  respondedBy     String?
  respondedAt     DateTime?
  rejectionReason String?

  teacher      Teacher                @relation(fields: [teacherId], references: [id])
  classSection ClassSection?          @relation(fields: [classSectionId], references: [id])
  substitutes  SubstituteAssignment[]

  @@index([teacherId])
  @@index([status])
  @@index([date])
}

enum SubstituteStatus {
  PENDING_SUBSTITUTE_APPROVAL
  CONFIRMED
  DECLINED
}

/// One specific session's substitute coverage — the substitute must accept
/// before it's confirmed and shows up in anyone's schedule.
model SubstituteAssignment {
  id                  String           @id @default(cuid())
  teacherAbsenceId    String
  classSectionId      String
  date                DateTime         @db.Date
  originalTeacherId   String
  substituteTeacherId String
  status              SubstituteStatus @default(PENDING_SUBSTITUTE_APPROVAL)
  assignedBy          String
  assignedAt          DateTime         @default(now())
  respondedAt         DateTime?

  teacherAbsence    TeacherAbsence @relation(fields: [teacherAbsenceId], references: [id])
  classSection      ClassSection   @relation(fields: [classSectionId], references: [id])
  originalTeacher   Teacher        @relation("OriginalTeacherAssignments", fields: [originalTeacherId], references: [id])
  substituteTeacher Teacher        @relation("SubstituteTeacherAssignments", fields: [substituteTeacherId], references: [id])
  payAdjustments    TeacherPayAdjustment[]

  @@index([classSectionId])
  @@index([originalTeacherId])
  @@index([substituteTeacherId])
  @@index([date])
}

/// A specific session cancelled because no substitute was found (or chosen
/// not to use one). Visible wherever the group's schedule is shown, so
/// nobody shows up expecting a session that isn't happening.
model CancelledSession {
  id             String   @id @default(cuid())
  classSectionId String
  date           DateTime @db.Date
  reason         String?
  cancelledBy    String // User id
  createdAt      DateTime @default(now())

  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@unique([classSectionId, date])
  @@index([classSectionId])
}

enum GroupStatus {
  ACTIVE
  COMPLETED
}

enum GroupCycleType {
  MONTH_COMPLETED
  LEVEL_COMPLETED
}

/// One row per "cycle finished" action on a group — a completed billing
/// month (MONTHLY levels) or a completed level (FULL_LEVEL levels, which
/// also advances the group to the next level). Kept even after the group
/// moves on, so group financials/reporting can later show exactly what was
/// completed and when.
model GroupCycleLog {
  id            String         @id @default(cuid())
  classSectionId String
  type          GroupCycleType
  levelId       String? // the level that was active when this cycle closed
  cycleNumber   Int? // which month number, for MONTH_COMPLETED
  completedAt   DateTime       @default(now())
  completedBy   String // User id
  // The new group created (if any) for students who continued — set once
  // the "who's continuing" step is confirmed via the manual advance button.
  newClassSectionId String?

  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@index([classSectionId])
}

/// A manual bonus or deduction on top of a teacher's computed group pay.
/// amount is positive for a bonus, negative for a deduction — always with a
/// reason on record.
model TeacherPayAdjustment {
  id             String   @id @default(cuid())
  teacherId      String
  classSectionId String? // null = a general adjustment, not tied to one group
  cycleNumber    Int? // which billing cycle this applies to, if relevant
  amount         Decimal  @db.Decimal(10, 2)
  reason         String
  createdBy      String // User id
  createdAt      DateTime @default(now())
  // Links this adjustment back to the substitute-coverage event it settles
  // (a bonus for the covering teacher, or a deduction for the absent one) —
  // lets the reconciliation screen know an event's already been handled.
  substituteAssignmentId String?

  teacher              Teacher               @relation(fields: [teacherId], references: [id])
  classSection         ClassSection?         @relation(fields: [classSectionId], references: [id])
  substituteAssignment SubstituteAssignment? @relation(fields: [substituteAssignmentId], references: [id])

  @@index([teacherId])
  @@index([classSectionId])
  @@index([substituteAssignmentId])
}


model ElectiveGroup {
  id             String   @id @default(cuid())
  name           String
  minSelections  Int      @default(1)
  maxSelections  Int      @default(1)
  classSectionId String
  createdAt      DateTime @default(now())

  classSection ClassSection      @relation(fields: [classSectionId], references: [id])
  offerings    SubjectOffering[]

  @@index([classSectionId])
}

model SubjectEnrollment {
  id                  String                  @id @default(cuid())
  studentEnrollmentId String
  subjectOfferingId   String
  status              SubjectEnrollmentStatus @default(PENDING)
  approvedById        String?
  createdAt           DateTime                @default(now())

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  subjectOffering   SubjectOffering   @relation(fields: [subjectOfferingId], references: [id])

  @@unique([studentEnrollmentId, subjectOfferingId])
}

model TimetableSlot {
  id                String            @id @default(cuid())
  academicYearId    String
  classSectionId    String
  subjectOfferingId String
  teacherId         String?
  roomId            String?
  dayOfWeek         Int // 1=Monday … 7=Sunday
  startTime         String
  endTime           String
  slotType          TimetableSlotType @default(SUBJECT)
  templateId        String?
  isPublished       Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  academicYear    AcademicYear             @relation(fields: [academicYearId], references: [id])
  classSection    ClassSection             @relation(fields: [classSectionId], references: [id])
  subjectOffering SubjectOffering          @relation(fields: [subjectOfferingId], references: [id])
  teacher         Teacher?                 @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  room            Room?                    @relation(fields: [roomId], references: [id])
  template        TimetableTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  changeRequests  TimetableChangeRequest[]

  @@index([academicYearId])
  @@index([classSectionId])
  @@index([teacherId])
  @@index([teacherId, academicYearId, isPublished, dayOfWeek])
  @@index([academicYearId, classSectionId, isPublished, dayOfWeek])
  @@index([dayOfWeek])
  @@index([templateId])
}

model TimetableTemplate {
  id             String   @id @default(cuid())
  academicYearId String
  shiftId        String?
  name           String   @db.VarChar(120)
  definition     Json
  createdById    String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  shift        Shift?          @relation(fields: [shiftId], references: [id])
  createdBy    User            @relation("TimetableTemplateCreatedBy", fields: [createdById], references: [id])
  slots        TimetableSlot[]

  @@index([academicYearId])
  @@index([shiftId])
  @@index([createdById])
}

model AcademicGradingScheme {
  id             String   @id @default(cuid())
  academicYearId String
  classSectionId String
  subjectId      String
  name           String
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  classSection ClassSection       @relation(fields: [classSectionId], references: [id])
  subject      AcademicSubject    @relation(fields: [subjectId], references: [id])
  components   GradingComponent[]

  @@unique([academicYearId, classSectionId, subjectId])
}

model GradingComponent {
  id               String @id @default(cuid())
  gradingSchemeId  String
  name             String
  maxMarks         Float
  weightPercentage Float
  orderIndex       Int

  gradingScheme AcademicGradingScheme @relation(fields: [gradingSchemeId], references: [id], onDelete: Cascade)
  assessments   Assessment[]

  @@index([gradingSchemeId])
}

model Assessment {
  id                 String   @id @default(cuid())
  gradingComponentId String
  title              String
  dueDate            DateTime
  createdAt          DateTime @default(now())

  gradingComponent GradingComponent  @relation(fields: [gradingComponentId], references: [id], onDelete: Cascade)
  scores           AssessmentScore[]
}

model AssessmentScore {
  id                  String   @id @default(cuid())
  assessmentId        String
  studentEnrollmentId String
  obtainedMarks       Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  assessment        Assessment        @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentEnrollmentId])
}

model EnrollmentAttendanceRecord {
  id                  String           @id @default(cuid())
  studentEnrollmentId String
  attendanceDate      DateTime         @db.Date
  status              AttendanceStatus
  markedByTeacherId   String
  // Who actually taught/led this session — separate from markedByTeacherId
  // (who clicked Save), since a secretary or admin can record attendance on
  // a teacher's behalf. Defaults to the group's assigned instructor; used
  // for accurate per-session pay and, later, the substitute-teacher flow.
  taughtByTeacherId   String?
  remarks             String?
  createdAt           DateTime         @default(now())

  studentEnrollment StudentEnrollment @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)

  @@unique([studentEnrollmentId, attendanceDate])
  @@index([attendanceDate])
}

model FeePolicy {
  id                      String      @id @default(cuid())
  campusId                String?
  batchId                 String?
  graceDays               Int         @default(7)
  penaltyType             PenaltyType
  penaltyValue            Float
  maxPenalty              Float?
  allowedLeavesPerMonth   Int         @default(1)
  leavePenaltyAmount      Decimal     @default(0) @db.Decimal(10, 2)
  // Only ABSENT attendance records count toward this monthly limit.
  allowedAbsencesPerMonth Int         @default(3)
  absencePenaltyAmount    Decimal     @default(0) @db.Decimal(10, 2)
  isActive                Boolean     @default(true)
  createdAt               DateTime    @default(now())

  campus             Campus?             @relation(fields: [campusId], references: [id])
  batch              Batch?              @relation(fields: [batchId], references: [id])
  penaltyAssessments PenaltyAssessment[]
}

model TeacherPenaltyPolicy {
  id                    String      @id @default(cuid())
  campusId              String?
  lateThreshold         Int         @default(3)
  penaltyType           PenaltyType
  penaltyValue          Float
  repeatMultiplier      Float?
  allowedLeavesPerMonth Int         @default(1)
  leavePenaltyAmount    Decimal     @default(0) @db.Decimal(10, 2)
  // Late arrivals are measured against this configurable grace period.
  lateGraceMinutes      Int         @default(25)
  // Number of late events that may pass without a financial penalty.
  freeLatePasses        Int         @default(0)
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())

  campus             Campus?             @relation(fields: [campusId], references: [id])
  penaltyAssessments PenaltyAssessment[]
}

// ─────────────────────────────────────────────────────────────────────────────
// PENALTY ASSESSMENTS
// ─────────────────────────────────────────────────────────────────────────────
// A qualifying attendance/leave event creates one idempotent assessment.
// The compound source key prevents duplicate charges when attendance is
// retried or imported more than once. Posting is a separate controlled step.
model PenaltyAssessment {
  id              String                  @id @default(cuid())
  type            PenaltyAssessmentType
  status          PenaltyAssessmentStatus @default(PENDING)
  sourceId        String
  studentId       String?
  teacherId       String?
  policyId        String?
  teacherPolicyId String?
  amount          Decimal                 @db.Decimal(10, 2)
  reason          String
  periodStart     DateTime?
  periodEnd       DateTime?
  feeInvoiceId    String?
  salarySlipId    String?
  reviewedById    String?
  reviewedAt      DateTime?
  postedAt        DateTime?
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  student              Student?              @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher              Teacher?              @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  feePolicy            FeePolicy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  teacherPenaltyPolicy TeacherPenaltyPolicy? @relation(fields: [teacherPolicyId], references: [id], onDelete: SetNull)
  feeInvoice           FeeInvoice?           @relation(fields: [feeInvoiceId], references: [id], onDelete: SetNull)
  salarySlip           SalarySlip?           @relation(fields: [salarySlipId], references: [id], onDelete: SetNull)

  @@unique([type, sourceId])
  @@index([status, type])
  @@index([studentId, createdAt])
  @@index([teacherId, createdAt])
  @@index([teacherPolicyId])
  @@index([feeInvoiceId])
  @@index([salarySlipId])
}

model PromotionRecord {
  id               String          @id @default(cuid())
  studentId        String
  academicYearId   String?
  fromEnrollmentId String
  toEnrollmentId   String?
  promotionStatus  PromotionStatus
  promotedById     String
  remarks          String?
  createdAt        DateTime        @default(now())

  student        Student            @relation(fields: [studentId], references: [id])
  academicYear   AcademicYear?      @relation(fields: [academicYearId], references: [id])
  fromEnrollment StudentEnrollment  @relation("PromotionFrom", fields: [fromEnrollmentId], references: [id])
  toEnrollment   StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id])

  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MONTHLY FEEDBACK (students → staff, management, accounts, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model FeedbackQuestion {
  id         String           @id @default(cuid())
  category   FeedbackCategory @default(TEACHER)
  text       String
  orderIndex Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())

  answers FeedbackAnswer[]
}

model MonthlyFeedbackCycle {
  id        String    @id @default(cuid())
  year      Int
  month     Int
  label     String
  isOpen    Boolean   @default(true)
  opensAt   DateTime  @default(now())
  closesAt  DateTime?
  createdAt DateTime  @default(now())

  submissions StudentFeedbackSubmission[]

  @@unique([year, month])
}

model StudentFeedbackSubmission {
  id                  String   @id @default(cuid())
  cycleId             String
  studentId           String?
  studentEnrollmentId String?
  campusId            String
  batchId             String
  // WHY: Distinguishes student vs guardian feedback in aggregation queries
  submitterRole       Role     @default(STUDENT)
  submitterUserId     String // User.id of whoever submitted (student or guardian)
  guardianId          String? // Set when submitter is PARENT/GUARDIAN
  submittedAt         DateTime @default(now())

  cycle       MonthlyFeedbackCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  student     Student?             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment  StudentEnrollment?   @relation(fields: [studentEnrollmentId], references: [id], onDelete: Cascade)
  answers     FeedbackAnswer[]
  suggestions Json? // Stores category-specific suggestions/comments

  // WHY: One submission per user per cycle — works for both students and guardians
  @@unique([cycleId, submitterUserId])
  @@index([cycleId])
  @@index([studentId])
  @@index([submitterUserId])
  @@index([submitterRole])
}

model FeedbackAnswer {
  id              String                 @id @default(cuid())
  submissionId    String
  questionId      String
  targetTeacherId String?
  response        FeedbackLikertResponse

  submission    StudentFeedbackSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question      FeedbackQuestion          @relation(fields: [questionId], references: [id])
  targetTeacher Teacher?                  @relation(fields: [targetTeacherId], references: [id])

  @@unique([submissionId, questionId, targetTeacherId])
  @@index([submissionId])
  @@index([questionId])
  @@index([targetTeacherId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPENSE MANAGEMENT (Phase 15 — Account Manager Module)
// WHY: Separate model from FeeInvoice — institutional operating expenses are
//      a distinct financial domain from student fee collection.
// ─────────────────────────────────────────────────────────────────────────────

model Expense {
  id               String          @id @default(cuid())
  title            String // "Electricity Bill May", "Whiteboard Markers x50"
  description      String?
  amount           Decimal         @db.Decimal(10, 2)
  category         ExpenseCategory
  date             DateTime        @db.Date
  campusId         String
  receiptUrl       String? // Cloudinary URL of scanned receipt
  // recordedBy stores the Accountant's User ID when a finance user records the expense.
  // recordedByUserId stores the actual acting User ID for SuperAdmin/Admin records too.
  recordedBy       String?
  recordedByUserId String?
  // WHY paymentSource as String not enum: supports freeform labels like
  // "Petty Cash", "HBL Bank Transfer", "Cheque #1234" without schema migrations.
  paymentSource    String? // "Cash" | "Bank Transfer" | "Cheque" | "Petty Cash"
  paymentReference String? // Bank transaction ID, cheque number, etc.
  // TRADEOFF: isApproved defaults true (B-OFF mode). Feature flag
  // EXPENSE_APPROVAL_REQUIRED=true activates approval gate without migration.
  isApproved       Boolean         @default(true)
  approvedBy       String? // Admin User ID when manually approved
  // WHY isDeleted soft-delete: Financial records must never be hard-deleted.
  // Regulators and auditors require immutable historical records.
  isDeleted        Boolean         @default(false)
  notes            String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  campus         Campus      @relation(fields: [campusId], references: [id])
  accountant     Accountant? @relation(fields: [recordedBy], references: [userId])
  recordedByUser User?       @relation("ExpenseRecordedByUser", fields: [recordedByUserId], references: [id])

  @@index([campusId])
  @@index([category])
  @@index([date]) // Primary query pattern: range filter by date for reports
  @@index([recordedBy])
  @@index([recordedByUserId])
  @@index([isDeleted]) // Exclude soft-deleted in all list queries
  @@index([paymentSource]) // For payment-source-filtered expense reports
}

// ─────────────────────────────────────────────────────────────────────────────
// TEACHER DOCUMENTS — audit record for generated teacher PDFs
// WHY separate model: TeacherDocument tracks staff-specific generated documents
// (ID cards, experience letters, profiles) without polluting the student-only
// Certificate table. Scoped to SUPER_ADMIN issuance.
// ─────────────────────────────────────────────────────────────────────────────
model TeacherDocument {
  id        String          @id @default(cuid())
  teacherId String
  type      CertificateType
  title     String
  pdfUrl    String
  issuedBy  String // userId of superadmin who triggered generation
  remarks   String?
  createdAt DateTime        @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
  @@index([type])
  @@index([issuedBy])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 4: Student Enrollment Types & Dynamic Tagging
// ─────────────────────────────────────────────────────────────────────────────
enum EnrollmentType {
  REGULAR
  SUPPLEMENTARY
  PRACTICAL_ONLY
  AUDIT
}

model EnrollmentTypeAuditLog {
  id            String         @id @default(cuid())
  studentId     String
  previousType  EnrollmentType
  newType       EnrollmentType
  changedById   String
  reason        String
  effectiveDate DateTime       @default(now())
  createdAt     DateTime       @default(now())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User    @relation(fields: [changedById], references: [id])

  @@index([studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 3: Exam Date Sheets
// ─────────────────────────────────────────────────────────────────────────────
model ExamDateSheet {
  id             String   @id @default(cuid())
  classSectionId String
  examSessionId  String // Link to academic term/session
  title          String // e.g., "Final Term Examination 2026"
  isPublished    Boolean  @default(false)
  version        Int      @default(1)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  classSection ClassSection            @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  createdBy    User                    @relation(fields: [createdById], references: [id])
  slots        ExamDateSheetSlot[]
  overrides    ExamDateSheetOverride[]

  @@unique([classSectionId, examSessionId])
}

model ExamDateSheetSlot {
  id                String   @id @default(cuid())
  dateSheetId       String
  subjectOfferingId String // Link to the specific offering in that section
  examDate          DateTime @db.Date
  startTime         String // Format "HH:MM AM/PM"
  endTime           String
  roomNumber        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dateSheet       ExamDateSheet   @relation(fields: [dateSheetId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)

  @@unique([dateSheetId, subjectOfferingId])
}

model ExamDateSheetOverride {
  id                String   @id @default(cuid())
  dateSheetId       String
  studentId         String
  subjectOfferingId String
  examDate          DateTime @db.Date
  startTime         String
  endTime           String
  createdAt         DateTime @default(now())

  dateSheet       ExamDateSheet   @relation(fields: [dateSheetId], references: [id], onDelete: Cascade)
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)

  @@unique([studentId, dateSheetId, subjectOfferingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 5 & 6: Teacher Result Module & Daily Performance Score Entry
// ─────────────────────────────────────────────────────────────────────────────
enum ResultDeclarationStatus {
  DRAFT
  DECLARED
}

enum ResultCardPositionMode {
  HIDDEN
  SYSTEM_APPROVED
  MANUAL
}

model TermResult {
  id                String                  @id @default(cuid())
  studentId         String
  classSectionId    String
  examSessionId     String
  overallPercentage Decimal                 @db.Decimal(5, 2)
  grade             String
  classPosition     Int?
  manualPosition    Int?
  // performanceBatch: auto-derived (≥90=Ever Shine, 80-89=Quaid, 60-79=Iqbal, <60=Improvement)
  // Teacher can manually override; last-writer-wins with audit log entry.
  performanceBatch  String
  teacherRemarks    String? // Overall teacher remarks for this result
  // WHY Json: Teachers can add institution-specific custom columns
  // (e.g. "Co-curricular Score", "Discipline Points") without schema migration.
  // Format: [{label: string, value: string}]
  customFields      Json?
  declarationStatus ResultDeclarationStatus @default(DRAFT)
  declaredAt        DateTime?
  declaredById      String?
  teacherId         String? // Teacher who owns this draft/result
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher        Teacher?        @relation(fields: [teacherId], references: [id])
  classSection   ClassSection    @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  declaredBy     User?           @relation(fields: [declaredById], references: [id])
  subjectResults SubjectResult[]

  @@unique([studentId, classSectionId, examSessionId])
  @@index([classSectionId, examSessionId])
  @@index([teacherId])
  @@index([declarationStatus])
}

model ResultCardConfig {
  id                   String                 @id @default(cuid())
  classSectionId       String
  examSessionId        String
  examTitleOverride    String?                @db.VarChar(120)
  academyNameOverride  String?                @db.VarChar(120)
  showStudentInfo      Boolean                @default(true)
  showSubjectNames     Boolean                @default(true)
  showTotalMarks       Boolean                @default(true)
  showObtainedMarks    Boolean                @default(true)
  showPercentage       Boolean                @default(true)
  showGrade            Boolean                @default(true)
  showResultStatus     Boolean                @default(true)
  showTeacherRemarks   Boolean                @default(true)
  showPerformanceBatch Boolean                @default(true)
  showCustomFields     Boolean                @default(true)
  showClassPosition    Boolean                @default(false)
  positionMode         ResultCardPositionMode @default(HIDDEN)
  createdById          String?
  updatedById          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([classSectionId, examSessionId])
  @@index([examSessionId])
}

model SubjectResult {
  id                String   @id @default(cuid())
  termResultId      String
  subjectOfferingId String
  totalMarks        Int
  obtainedMarks     Decimal? @db.Decimal(5, 2) // Nullable for "Input Decide Later"
  isAbsent          Boolean  @default(false)
  isNotApplicable   Boolean  @default(false)
  percentage        Decimal? @db.Decimal(5, 2)
  grade             String?
  // resultStatus: explicit string status for export display
  // Values: "Pass" | "Fail" | "Absent" | "N/A" | "Pending"
  resultStatus      String?  @default("Pending")
  remarks           String? // Subject-level remarks (e.g. "Above Average")
  performanceBatch  String? // Derived subject performance
  // WHY Json: mirrors TermResult.customFields — subject-level custom values
  // Format: [{label: string, value: string}]
  customFieldValues Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  termResult      TermResult      @relation(fields: [termResultId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)

  @@unique([termResultId, subjectOfferingId])
}

model DailyPerformanceScore {
  id                String   @id @default(cuid())
  studentId         String
  subjectOfferingId String
  date              DateTime @db.Date
  score             Decimal  @db.Decimal(5, 2)
  isAbsent          Boolean  @default(false)
  grade             String?
  highlight         String? // STAR_OF_THE_DAY | POOR
  remarks           String?
  markedById        String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  markedBy        User            @relation(fields: [markedById], references: [id])

  @@unique([studentId, subjectOfferingId, date])
  @@index([subjectOfferingId, date])
}

// Audit logs for retroactive edits on results or daily scores
model RetroactiveScoreEditLog {
  id            String   @id @default(cuid())
  entityType    String // "TERM_RESULT" | "DAILY_PERFORMANCE"
  entityId      String
  previousMarks String?
  newMarks      String
  reason        String
  editedById    String
  createdAt     DateTime @default(now())

  editedBy User @relation(fields: [editedById], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 8: Marks Achievement Target Assignment
// ─────────────────────────────────────────────────────────────────────────────
model TargetAssignment {
  id                String   @id @default(cuid())
  studentId         String
  subjectOfferingId String
  targetGrade       String // e.g. "A", "B", "C", "D"
  minPercentage     Decimal  @db.Decimal(5, 2)
  maxPercentage     Decimal  @db.Decimal(5, 2)
  assignedById      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectOffering SubjectOffering @relation(fields: [subjectOfferingId], references: [id], onDelete: Cascade)
  assignedBy      User            @relation(fields: [assignedById], references: [id])

  @@unique([studentId, subjectOfferingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 9 & 11: Financial Reporting — Profit/Loss & Reserve Fund
// WHY: Separate from Expense/FeePayment — these are aggregated financial
//      statements, not transaction records. Immutable once generated.
// ─────────────────────────────────────────────────────────────────────────────

model ProfitLossStatement {
  id                    String   @id @default(cuid())
  // campusId null = institution-wide consolidated statement
  campusId              String?
  periodLabel           String // "June 2026"
  periodStart           DateTime
  periodEnd             DateTime
  totalIncome           Decimal  @db.Decimal(12, 2) // Sum of FeePayments in period
  totalExpenses         Decimal  @db.Decimal(12, 2) // Sum of Expenses in period
  grossMargin           Decimal  @db.Decimal(12, 2) // totalIncome - totalExpenses
  // profitPercentage: Account Manager specifies this for SuperAdmin allocation
  profitPercentage      Decimal  @db.Decimal(5, 2) // e.g. 20.00
  superAdminAllocation  Decimal  @db.Decimal(12, 2) // grossMargin * (profitPercentage/100)
  // RULE: SuperAdmin draws 75% of their allocation monthly
  superAdminMonthlyDraw Decimal  @db.Decimal(12, 2) // superAdminAllocation * 0.75
  // RULE: Remaining 25% of allocation goes to Reserve Fund automatically
  reserveContribution   Decimal  @db.Decimal(12, 2) // superAdminAllocation * 0.25
  remainingAmount       Decimal  @db.Decimal(12, 2) // grossMargin - superAdminAllocation
  generatedBy           String // Accountant User.id
  // WHY Json snapshot: prevents historical statements from changing if
  // underlying expense/fee records are later amended or soft-deleted
  snapshotData          Json // Full breakdown: {incomeItems[], expenseItems[]}
  createdAt             DateTime @default(now())

  campus       Campus?            @relation(fields: [campusId], references: [id])
  reserveEntry ReserveFundLedger?

  @@index([campusId])
  @@index([periodStart])
  @@index([generatedBy])
}

// WHY append-only design: Reserve Fund is a cumulative running total.
// Each row represents one month's contribution. Never update or delete.
// cumulativeTotal is denormalized for O(1) "current balance" reads.
model ReserveFundLedger {
  id                 String   @id @default(cuid())
  profitLossId       String   @unique
  campusId           String? // mirrors parent ProfitLossStatement
  contributionAmount Decimal  @db.Decimal(12, 2)
  // cumulativeTotal = SUM of all prior contributions + this one
  // Denormalized: computed inside $transaction to prevent race conditions
  cumulativeTotal    Decimal  @db.Decimal(12, 2)
  periodLabel        String // "June 2026"
  transactionDate    DateTime @default(now())
  notes              String?

  profitLoss ProfitLossStatement @relation(fields: [profitLossId], references: [id])

  @@index([transactionDate])
  @@index([campusId])
}

// ─────────────────────────────────────────────────────────────────────────────
// FEATURE 7 EXTENSION: Monthly Monitoring Report
// Snapshot-based: generated by teacher, stored for historical reference.
// Structure mirrors monthly monitering report.jpeg grid format.
// ─────────────────────────────────────────────────────────────────────────────
model MonthlyMonitoringReport {
  id                String                  @id @default(cuid())
  classSectionId    String
  month             Int // 1–12
  year              Int
  academicYearId    String
  generatedById     String // Teacher User.id
  declarationStatus ResultDeclarationStatus @default(DRAFT)
  declaredAt        DateTime?
  declaredById      String?
  // WHY Json: subject columns vary per section based on SubjectOffering;
  // storing as snapshot prevents report from changing when offerings change.
  // Format: {students: [{name, rollNo, subjectScores: {offeringId: marks}, totalMarks, obtainedMarks, rank}], performanceBatches: {}}
  reportData        Json
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@unique([classSectionId, month, year, academicYearId])
  @@index([classSectionId])
  @@index([generatedById])
  @@index([declarationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// LANDING PAGE — VISITOR INQUIRIES
// WHY: Persists contact form submissions from the public landing page.
// Each inquiry follows the lifecycle: NEW → SEEN → REPLIED → RESOLVED | SPAM.
// Data separated from admissions/staff applications — visitors are not applicants.
// ─────────────────────────────────────────────────────────────────────────────
model LandingInquiry {
  id String @id @default(cuid())

  // Visitor identity (no authentication required)
  name    String
  phone   String
  email   String?
  message String  @db.Text

  // WHY source: Distinguishes contact form from future WhatsApp integration.
  source InquirySource @default(CONTACT_FORM)

  // Admin workflow
  status     InquiryStatus @default(NEW)
  adminReply String?       @db.Text // Internal note or drafted reply
  repliedAt  DateTime?
  repliedBy  String? // User.id of admin who replied

  // Metadata — stored for spam detection, never exposed in public API
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([source])
}

// ─────────────────────────────────────────────────────────────────────────────
// LANDING PAGE — STAFF / TEACHER APPLICATIONS
// WHY: Dedicated table for staff recruitment applications from the landing page.
// Mirrors AdmissionRequest lifecycle pattern but provisions Teacher/Accountant/Admin
// on approval via atomic $transaction. CNIC allows re-application after 90-day
// cooldown if previously declined.
// ─────────────────────────────────────────────────────────────────────────────
model StaffApplicationRequest {
  id String @id @default(cuid())

  // ── Identity ──────────────────────────────────────────────────────────────
  fullName    String
  // WHY NOT @unique: Allows re-application after 90-day cooldown if declined.
  // Dedup guard is enforced in the API layer with cooldown logic.
  cnic        String
  dateOfBirth DateTime?
  gender      Gender?
  address     String?
  city        String?

  // ── Contact ───────────────────────────────────────────────────────────────
  phone String
  email String

  // ── Professional profile ──────────────────────────────────────────────────
  applicantType     StaffApplicantType @default(TEACHER)
  qualification     String
  specialization    String
  experienceYears   Int                @default(0)
  preferredShift    SessionShift?
  preferredCampusId String?

  // ── Documents ─────────────────────────────────────────────────────────────
  cvDocUrl String? // Server-saved PDF path
  cvLink   String? // External URL fallback

  // ── Admin workflow ────────────────────────────────────────────────────────
  status        StaffApplicationStatus @default(PENDING)
  reviewedBy    String? // User.id of super-admin who acted
  adminNotes    String?                @db.Text
  interviewDate DateTime?
  declinedAt    DateTime?
  approvedAt    DateTime?

  // WHY: Links to the User record created on approval for audit trail.
  // Null until status = APPROVED.
  provisionedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([applicantType])
  @@index([cnic])
  @@index([createdAt])
}

model AttendanceImportLog {
  id           String   @id @default(cuid())
  fileName     String
  importType   String // "STAFF" | "STUDENT"
  totalRows    Int
  successRows  Int
  failedRows   Int
  errorLog     Json? // Array of { row: number, errors: string[] }
  importedById String
  createdAt    DateTime @default(now())

  importedBy User @relation(fields: [importedById], references: [id])
}

// ─────────────────────────────────────────────────────────────────────────────
// WAITING LIST
// WHY a table: registration does not record which course/level a student
// wants. An entry = "this student wants course X (level Y, optional) at
// branch Z". It becomes PLACED automatically when the student is added to a
// group of that course (and level, if set). Students waiting for an upcoming
// group, and students who finished a group and did not continue, are
// computed from enrollments and need no row here.
// ─────────────────────────────────────────────────────────────────────────────

enum WaitingListStatus {
  WAITING
  PLACED
  CANCELLED
}

model WaitingListEntry {
  id                   String            @id @default(cuid())
  studentId            String
  subjectId            String // course wanted
  levelId              String? // level wanted; null = not decided yet (e.g. placement test pending)
  campusId             String // branch
  notes                String?           @db.Text
  status               WaitingListStatus @default(WAITING)
  placedClassSectionId String?
  placedAt             DateTime?
  /// Phase A: waiting for this specific (full) group; null = any group of the course/level
  classSectionId       String?
  createdById          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject AcademicSubject @relation(fields: [subjectId], references: [id])
  level   Level?          @relation(fields: [levelId], references: [id])
  campus  Campus          @relation(fields: [campusId], references: [id])

  @@index([subjectId, levelId, status])
  @@index([studentId, status])
  @@index([campusId, status])
  @@index([classSectionId, status])
}

/// Failed sign-in attempts, used to slow down password guessing
/// (lib/auth/login-throttle.ts). Only failures are stored; rows older than a
/// day are removed automatically. No relation to User on purpose: attempts on
/// unknown accounts are counted too.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// Resolved login email (phone logins resolve to the parent's email), or the
  /// typed identifier, lower-cased, when no account matches.
  identifier String   @db.VarChar(191)
  ip         String   @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// One request counted by the generic rate limiter (lib/rate-limit-db.ts) for
/// public forms: forgot password, contact form, job applications, admission
/// applications, certificate verification. Rows older than a day are deleted.
model RateLimitHit {
  id        String   @id @default(cuid())
  /// e.g. "forgot-password:ip:1.2.3.4" or "forgot-password:email:a@b.com"
  key       String   @db.VarChar(191)
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCE SETTINGS + DISCOUNTS (2026-10-02, docs/design-discounts.md)
// ─────────────────────────────────────────────────────────────────────────────

/// Small key/value settings edited from the UI (JSON values), e.g.
/// "finance.invoiceDueDays", "discounts.rules". See lib/settings/app-settings.ts.
model AppSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Where parents send money (shown on invoices and in the parent portal).
/// kind: INSTAPAY | VODAFONE_CASH | BANK | FAWRY | ONLINE_GATEWAY | OTHER
/// (ONLINE_GATEWAY is reserved for a future online payment provider).
model PaymentAccount {
  id            String   @id @default(cuid())
  kind          String   @db.VarChar(30)
  label         String
  accountName   String?
  accountNumber String?
  bankName      String?
  iban          String?
  instructions  String?  @db.Text
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Methods staff can pick when recording a payment (Cash, InstaPay...).
/// FeePayment.paymentMethod stores the name (text), so renaming or disabling
/// a method never changes old payments.
model PaymentMethod {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true)
  /// Built-in methods the system itself uses (cannot be deleted).
  isSystem  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// A kind of discount, managed from Discounts > Types.
model DiscountType {
  id           String    @id @default(cuid())
  name         String
  /// MANUAL | SIBLING | PROMO | OTHER
  kind         String    @db.VarChar(20)
  /// PERCENT | FIXED
  valueType    String    @db.VarChar(10)
  value        Decimal   @db.Decimal(10, 2)
  /// Staff may type the value when applying it (up to maxValue).
  editableValue Boolean  @default(false)
  maxValue     Decimal?  @db.Decimal(10, 2)
  /// EVERY_CYCLE | FIRST_CYCLE | ONE_TIME
  duration     String    @db.VarChar(20)
  /// Applied by the system without an assignment (siblings, promos for a scope).
  autoApply    Boolean   @default(false)
  /// STAFF | MANAGER | STAFF_WITH_APPROVAL
  approvalMode String    @db.VarChar(25)
  /// ALL | TRACK | COURSE | LEVEL | GROUP (+ scopeId)
  scopeType    String    @default("ALL") @db.VarChar(10)
  scopeId      String?
  validFrom    DateTime?
  validTo      DateTime?
  /// Can be combined with other discounts on the same invoice.
  stackable    Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignments      DiscountAssignment[]
  invoiceDiscounts InvoiceDiscount[]
}

/// A discount given to a student (optionally only in one group or track) or to
/// a whole group (studentId null + classSectionId).
model DiscountAssignment {
  id             String    @id @default(cuid())
  discountTypeId String
  studentId      String?
  classSectionId String?
  trackId        String?
  /// Value resolved when applied (the type's value, or what staff typed).
  value          Decimal   @db.Decimal(10, 2)
  /// PENDING | ACTIVE | REJECTED | ENDED
  status         String    @default("ACTIVE") @db.VarChar(10)
  reason         String?   @db.Text
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?   @db.Text
  endedAt        DateTime?
  endedById      String?
  /// Invoices this assignment was applied to (for FIRST_CYCLE / ONE_TIME).
  timesUsed      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  discountType     DiscountType      @relation(fields: [discountTypeId], references: [id])
  invoiceDiscounts InvoiceDiscount[]

  @@index([studentId, status])
  @@index([classSectionId, status])
  @@index([status])
}

/// One discount applied to one invoice (FeeInvoice.discount is the total).
model InvoiceDiscount {
  id             String   @id @default(cuid())
  invoiceId      String
  /// Copied from the invoice: counts "once per student" for group-wide/auto discounts.
  studentId      String
  discountTypeId String
  assignmentId   String?
  label          String
  amount         Decimal  @db.Decimal(10, 2)
  appliedById    String?
  createdAt      DateTime @default(now())

  discountType DiscountType        @relation(fields: [discountTypeId], references: [id])
  assignment   DiscountAssignment? @relation(fields: [assignmentId], references: [id])

  @@index([invoiceId])
  @@index([discountTypeId, createdAt])
  @@index([studentId, discountTypeId])
  @@index([assignmentId, studentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// REFUNDS + STUDENT WALLET (2026-10-02, docs/design-discounts.md part 3)
// ─────────────────────────────────────────────────────────────────────────────

/// Refund policy for a scope (most specific wins: GROUP > LEVEL > COURSE > TRACK > ALL).
model RefundRule {
  id            String   @id @default(cuid())
  /// ALL | TRACK | COURSE | LEVEL | GROUP
  scopeType     String   @default("ALL") @db.VarChar(10)
  scopeId       String?
  allowed       Boolean  @default(true)
  /// FIXED | PERCENT (of what the student paid)
  adminFeeType  String   @default("FIXED") @db.VarChar(10)
  adminFeeValue Decimal  @default(0) @db.Decimal(10, 2)
  /// ATTENDED = sessions the student attended; HELD = sessions the group held
  deductBasis   String   @default("ATTENDED") @db.VarChar(10)
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Money given back for an invoice: cash back, or credit in the student's wallet.
model Refund {
  id              String    @id @default(cuid())
  /// TN-RFND-YYYY-NNNNN, set when approved
  refundNumber    String?   @unique @db.VarChar(30)
  invoiceId       String
  studentId       String
  suggestedAmount Decimal   @db.Decimal(10, 2)
  amount          Decimal   @db.Decimal(10, 2)
  /// CASH | WALLET
  method          String    @db.VarChar(10)
  /// How the cash goes back (a payment method name), for CASH
  payoutMethod    String?   @db.VarChar(50)
  reason          String?   @db.Text
  /// How the suggestion was computed (sessions, price per session, admin fee)
  calc            Json?
  /// Also remove the student from the group when approved
  withdrawStudent Boolean   @default(false)
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING") @db.VarChar(10)
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  rejectedReason  String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([invoiceId])
  @@index([studentId])
  @@index([status])
  @@index([approvedAt])
}

/// Student wallet ledger: balance = sum(amount). + credit (refund), - spent (invoice payment).
model WalletTransaction {
  id          String   @id @default(cuid())
  studentId   String
  amount      Decimal  @db.Decimal(10, 2)
  /// REFUND | PAYMENT | ADJUSTMENT | TOPUP | WITHDRAW | TRANSFER_IN | TRANSFER_OUT
  type        String   @db.VarChar(12)
  refundId    String?
  paymentId   String?
  /// Phase B
  topUpId     String?
  withdrawalId String?
  /// the other child in a sibling transfer
  otherStudentId String?
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([studentId])
}

/// An online payment attempt (Paymob). The FeePayment is created only when the
/// provider confirms it through the signed webhook (lib/payments/paymob.ts).
model OnlinePayment {
  id              String   @id @default(cuid())
  /// null for a wallet top-up (kind TOPUP)
  invoiceId       String?
  studentId       String
  amount          Decimal  @db.Decimal(10, 2)
  /// Phase B: INVOICE | TOPUP
  kind            String   @default("INVOICE") @db.VarChar(8)
  /// Paymob fee paid by the parent on top of amount (phase B)
  fee             Decimal  @default(0) @db.Decimal(10, 2)
  topUpId         String?
  /// PAYMOB
  provider        String   @default("PAYMOB") @db.VarChar(20)
  /// PENDING | PAID | FAILED | REVIEW (amount mismatch etc.)
  status          String   @default("PENDING") @db.VarChar(10)
  providerOrderId String?  @db.VarChar(64)
  providerTxnId   String?  @unique @db.VarChar(64)
  /// FeePayment created after a successful, verified callback
  paymentId       String?
  note            String?  @db.Text
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([invoiceId])
  @@index([providerOrderId])
  @@index([status])
}

/// A student moved from one group to another (docs/design-student-transfer.md).
/// The money left over from the old group is returned as an approved refund
/// (refundId) to the wallet, and optionally paid onto the new invoice (paymentId).
model GroupTransfer {
  id                 String   @id @default(cuid())
  studentId          String
  fromClassSectionId String
  toClassSectionId   String
  fromEnrollmentId   String
  toEnrollmentId     String
  oldInvoiceId       String?
  newInvoiceId       String?
  sessionsCounted    Int      @default(0)
  perSession         Decimal  @default(0) @db.Decimal(10, 2)
  /// What the attended/held sessions cost (stays due on the old invoice)
  consumedAmount     Decimal  @default(0) @db.Decimal(10, 2)
  netPaidBefore      Decimal  @default(0) @db.Decimal(10, 2)
  /// Paid but not used: goes to the wallet / the new invoice
  creditAmount       Decimal  @default(0) @db.Decimal(10, 2)
  /// NEW_INVOICE | WALLET
  creditTo           String   @db.VarChar(12)
  /// Part of the new invoice actually paid from the credit
  creditApplied      Decimal  @default(0) @db.Decimal(10, 2)
  /// Unpaid part of the old invoice that was cancelled
  cancelledAmount    Decimal  @default(0) @db.Decimal(10, 2)
  refundId           String?
  paymentId          String?
  /// [{ assignmentId, typeName, action: MOVE | KEEP | END }]
  discountDecisions  Json?
  reason             String?  @db.Text
  createdById        String
  createdAt          DateTime @default(now())

  @@index([studentId])
  @@index([fromClassSectionId])
  @@index([toClassSectionId])
}


/// Phase A (docs/design-phase-a.md): every call / WhatsApp / meeting / visit with a parent,
/// plus messages the system sent (channel SYSTEM / auto = true).
model ContactLog {
  id          String    @id @default(cuid())
  studentId   String
  guardianId  String?
  campusId    String?
  /// CALL | WHATSAPP | MEETING | VISIT | SYSTEM
  channel     String    @db.VarChar(12)
  /// OUT (we contacted them) | IN (they contacted us)
  direction   String    @default("OUT") @db.VarChar(3)
  /// PAYMENT | ABSENCE | BEHAVIOUR | LEVEL | RENEWAL | COMPLAINT | OTHER
  reason      String    @db.VarChar(12)
  summary     String    @db.Text
  followUpAt  DateTime?
  followUpDoneAt DateTime?
  auto        Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([studentId, createdAt])
  @@index([followUpAt, followUpDoneAt])
  @@index([campusId])
}

/// Phase A: a day off for one branch (campusId) or the whole company (campusId null).
/// Sessions falling on it are postponed to the next scheduled slot.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  campusId    String?
  name        String
  createdById String
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([campusId])
}

/// Phase A: a one-off extra session for a group (e.g. to make up a holiday).
model ExtraSession {
  id             String   @id @default(cuid())
  classSectionId String
  date           DateTime @db.Date
  time           String   @db.VarChar(5)
  reason         String?
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([classSectionId, date])
  @@index([date])
}

/// Phase A: "is your child continuing next month?" — one per student per group (= per cycle).
model RenewalRequest {
  id             String    @id @default(cuid())
  classSectionId String
  studentId      String
  /// PENDING | YES | NO
  status         String    @default("PENDING") @db.VarChar(8)
  /// why not continuing: PRICE | TIME | LEVEL | TRAVEL | OTHER
  reason         String?   @db.VarChar(10)
  reasonNote     String?   @db.Text
  /// PARENT | STAFF
  respondedVia   String?   @db.VarChar(6)
  respondedById  String?
  respondedAt    DateTime?
  /// early-renewal discount given (DiscountAssignment id)
  discountAssignmentId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([classSectionId, studentId])
  @@index([status])
  @@index([studentId])
}

/// Phase B (docs/design-phase-b.md): money put in a student's wallet.
/// source STAFF (cash/transfer at the branch) | PROOF (parent uploaded a receipt) | ONLINE (Paymob)
/// | PAYMENT (money taken for an invoice: in and straight out again, so every payment passes the wallet).
model WalletTopUp {
  id             String    @id @default(cuid())
  /// TN-TOPUP-YYYY-NNNNN, set when approved
  topUpNumber    String?   @unique @db.VarChar(30)
  studentId      String
  amount         Decimal   @db.Decimal(10, 2)
  fee            Decimal   @default(0) @db.Decimal(10, 2)
  method         String    @db.VarChar(50)
  source         String    @db.VarChar(10)
  /// PENDING | APPROVED | REJECTED
  status         String    @default("PENDING") @db.VarChar(10)
  transactionId  String?   @db.VarChar(100)
  proofUrl       String?   @db.Text
  remarks        String?   @db.Text
  invoiceId      String?
  paymentId      String?
  rejectedReason String?   @db.Text
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([studentId, status])
  @@index([status, createdAt])
  @@index([approvedAt])
}

/// Phase B: money taken back out of a wallet (needs approval; fee by payout method).
model WalletWithdrawal {
  id               String    @id @default(cuid())
  /// TN-WDRW-YYYY-NNNNN, set when approved
  withdrawalNumber String?   @unique @db.VarChar(30)
  studentId        String
  amount           Decimal   @db.Decimal(10, 2)
  fee              Decimal   @default(0) @db.Decimal(10, 2)
  payoutMethod     String    @db.VarChar(50)
  reason           String?   @db.Text
  /// PENDING | APPROVED | REJECTED
  status           String    @default("PENDING") @db.VarChar(10)
  /// PARENT | STAFF
  requestedVia     String    @db.VarChar(6)
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([studentId, status])
  @@index([status])
}

/// Phase B: wallet rules per scope. kind MIN_TOPUP (minAmount) | WITHDRAW (allowed).
/// scopeType ALL | TRACK | COURSE | LEVEL | GROUP (+ scopeId); the most specific wins.
model WalletRule {
  id        String   @id @default(cuid())
  kind      String   @db.VarChar(10)
  scopeType String   @default("ALL") @db.VarChar(10)
  scopeId   String?
  minAmount Decimal? @db.Decimal(10, 2)
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}
/// Phase C: a parent's excuse for one session (docs/design-phase-c.md).
/// status PENDING | APPROVED | REJECTED | CANCELLED. Approved → the attendance is EXCUSED.
model AbsenceExcuse {
  id             String    @id @default(cuid())
  studentId      String
  classSectionId String
  sessionDate    DateTime  @db.Date
  reason         String    @db.VarChar(500)
  status         String    @default("PENDING") @db.VarChar(10)
  autoApproved   Boolean   @default(false)
  submittedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?   @db.VarChar(500)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, classSectionId, sessionDate])
  @@index([classSectionId, sessionDate])
  @@index([status])
}

/// Phase C: excuse settings per scope ALL | TRACK | COURSE | GROUP (+ scopeId); the most specific wins.
/// autoApprove = accepted at once; daysAfter = how many days after the session a parent may still send it.
model ExcuseRule {
  id          String   @id @default(cuid())
  scopeType   String   @default("ALL") @db.VarChar(10)
  scopeId     String?
  autoApprove Boolean  @default(true)
  daysAfter   Int      @default(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([scopeType, scopeId])
}

/// Phase C: "how was the session?" — rating 1..4 (🙁 😐 🙂 😀). byRole STUDENT | PARENT (parent answers for young children).
model SessionFeedback {
  id             String   @id @default(cuid())
  studentId      String
  classSectionId String
  sessionDate    DateTime @db.Date
  rating         Int
  comment        String?  @db.VarChar(500)
  byUserId       String
  byRole         String   @db.VarChar(8)
  createdAt      DateTime @default(now())

  @@unique([studentId, classSectionId, sessionDate])
  @@index([classSectionId])
}

/// Phase C: parent survey, kind MONTHLY (end of each month/group) | LEVEL (end of the level). Ratings 1..5.
model ParentSurvey {
  id             String   @id @default(cuid())
  studentId      String
  classSectionId String
  kind           String   @db.VarChar(8)
  teacherId      String?
  sessionsRating Int
  teacherRating  Int
  companyRating  Int
  comment        String?  @db.VarChar(1000)
  /// Phase D: "Would you recommend TechNova to a friend?" 0..10 (end of level)
  recommend      Int?
  byUserId       String
  createdAt      DateTime @default(now())

  @@unique([studentId, classSectionId, kind])
  @@index([teacherId])
  @@index([createdAt])
}

/// Phase C: one birthday greeting per person per year (the daily job may run more than once).
/// personType STUDENT | GUARDIAN | TEACHER | STAFF (personId = Student/Guardian/Teacher id, or User id for STAFF).
model BirthdayGreeting {
  id         String   @id @default(cuid())
  personType String   @db.VarChar(8)
  personId   String
  year       Int
  createdAt  DateTime @default(now())

  @@unique([personType, personId, year])
}

/// Phase D: a staff / sender message on a complaint. internal = staff-only note.
model ComplaintReply {
  id          String   @id @default(cuid())
  complaintId String
  authorId    String
  authorRole  String   @db.VarChar(16)
  body        String   @db.Text
  internal    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([complaintId])
}

/// Phase D: who referred whom. One referral per new student. status PENDING | REWARDED | CANCELLED.
/// The reward (wallet credit to one of the referrer's children) is given when the new student pays the first invoice.
model Referral {
  id                  String    @id @default(cuid())
  code                String
  referrerGuardianId  String
  referredStudentId   String    @unique
  status              String    @default("PENDING") @db.VarChar(10)
  rewardAmount        Decimal?  @db.Decimal(10, 2)
  rewardStudentId     String?
  welcomeAssignmentId String?
  createdById         String
  createdAt           DateTime  @default(now())
  rewardedAt          DateTime?

  @@index([referrerGuardianId])
  @@index([status])
}

/// Foundations (2026-10-09, docs/plan-learning-platform.md §16–17): agreements the user must accept.
/// audience PARENT | STUDENT | STAFF. Editing the text publishes a new version; mandatory ones block the portal
/// until the current version is accepted.
model Agreement {
  id          String    @id @default(cuid())
  key         String    @unique @db.VarChar(40)
  titleEn     String    @db.VarChar(160)
  titleAr     String    @db.VarChar(160)
  bodyEn      String    @db.Text
  bodyAr      String    @db.Text
  audience    String    @db.VarChar(8)
  mandatory   Boolean   @default(true)
  isActive    Boolean   @default(true)
  version     Int       @default(1)
  sortOrder   Int       @default(0)
  graceDays   Int       @default(0)
  publishedAt DateTime  @default(now())
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([audience, isActive])
}

/// Proof of acceptance: who, which version, when, from which device.
model AgreementAcceptance {
  id          String   @id @default(cuid())
  agreementId String
  version     Int
  userId      String
  acceptedAt  DateTime @default(now())
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(300)

  @@unique([agreementId, version, userId])
  @@index([userId])
}

/// LMS L1 (docs/plan-learning-platform.md §2): skills list of a course (tags for lessons / questions → skills radar).
model CourseSkill {
  id        String   @id @default(cuid())
  subjectId String
  nameEn    String   @db.VarChar(80)
  nameAr    String   @db.VarChar(80)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([subjectId])
}

/// LMS L1: a versioned curriculum of one level. status DRAFT | IN_REVIEW | PUBLISHED | ARCHIVED.
/// Running groups stay on the version they started with; new groups take the newest published one.
model CurriculumEdition {
  id            String    @id @default(cuid())
  levelId       String
  number        Int
  status        String    @default("DRAFT") @db.VarChar(10)
  notes         String?   @db.Text
  copiedFromId  String?
  createdById   String
  submittedAt   DateTime?
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([levelId, number])
  @@index([levelId, status])
}

/// LMS L1: one session (lesson) of an edition. Bilingual texts; instructor notes are never shown to students.
model CurriculumSession {
  id              String   @id @default(cuid())
  editionId       String
  number          Int
  titleEn         String   @default("") @db.VarChar(200)
  titleAr         String   @default("") @db.VarChar(200)
  objectivesEn    String?  @db.Text
  objectivesAr    String?  @db.Text
  materialsEn     String?  @db.Text
  materialsAr     String?  @db.Text
  instructorNotes String?  @db.Text
  durationMin     Int?
  skillIds        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([editionId, number])
}

/// LMS L1: a content block of a session. type TEXT | IMAGE | VIDEO | FILE | LINK | CODE | EMBED | H5P | QUIZ |
/// ASSIGNMENT | TOOL. audience BOTH | INSTRUCTOR | STUDENT. data = type-specific JSON (texts AR/EN, media ids, url…).
model CurriculumBlock {
  id        String   @id @default(cuid())
  sessionId String
  order     Int      @default(0)
  type      String   @db.VarChar(12)
  audience  String   @default("BOTH") @db.VarChar(10)
  titleEn   String?  @db.VarChar(200)
  titleAr   String?  @db.VarChar(200)
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, order])
}

/// LMS L1: review comments on a session while an edition is reviewed.
model CurriculumComment {
  id        String   @id @default(cuid())
  sessionId String
  authorId  String
  body      String   @db.Text
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/// LMS L2: the instructor opened (OPEN) or closed (LOCKED) one curriculum session for a group by hand.
/// sessionNumber = the curriculum session number in the level (not the session number inside the month).
model LessonUnlock {
  id             String   @id @default(cuid())
  classSectionId String
  sessionNumber  Int
  state          String   @db.VarChar(8)
  byUserId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([classSectionId, sessionNumber])
}

/// LMS L2: an extra note / link for ONE group and one session (does not change the curriculum).
model GroupLessonNote {
  id             String   @id @default(cuid())
  classSectionId String
  sessionNumber  Int
  body           String   @db.Text
  url            String?  @db.VarChar(1000)
  createdById    String
  createdAt      DateTime @default(now())

  @@index([classSectionId, sessionNumber])
}

/// LMS L2: a student ticked a content block as done.
model LessonProgress {
  id             String   @id @default(cuid())
  studentId      String
  blockId        String
  sessionId      String
  classSectionId String
  completedAt    DateTime @default(now())

  @@unique([studentId, blockId])
  @@index([studentId, sessionId])
}

/// LMS L2: who opened which lesson / file and when (to trace leaks). kind SESSION | MEDIA.
model LessonView {
  id             String   @id @default(cuid())
  userId         String
  studentId      String?
  classSectionId String?
  sessionId      String
  blockId        String?
  kind           String   @db.VarChar(8)
  ip             String?  @db.VarChar(64)
  userAgent      String?  @db.VarChar(300)
  createdAt      DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
}
